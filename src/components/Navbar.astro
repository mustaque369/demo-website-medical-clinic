---
import { CLINIC } from '../constants';
import { NAV_LINKS } from '../constants';
import PhoneIcon from './icons/PhoneIcon.astro';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import CalendarIcon from './icons/CalendarIcon.astro';

interface Props {
  currentPage: string;
}
const { currentPage } = Astro.props;

const phone = CLINIC.phone;
const phoneHref = CLINIC.phoneHref;
const whatsapp = CLINIC.whatsappUrl;
---

<header class="nav-header sticky top-0 z-40 bg-white border-b border-slate-200" aria-label="Main navigation">
  <div class="container-main">
    <div class="nav-inner">
      
      <!-- Brand -->
      <a href={import.meta.env.BASE_URL} class="nav-brand group">
        <div class="nav-logo" aria-hidden="true">
          <!-- Brain icon matching reference -->
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 2C9.5 2 7.5 3.5 7 5.5C5.5 5.8 4 7.5 4 9.5C4 11 4.8 12.3 6 13C5.7 14 6 15.5 7.5 16.5C7.3 17.5 7.8 19 9.5 19.5C10 21 11 22 12 22C13 22 14 21 14.5 19.5C16.2 19 16.7 17.5 16.5 16.5C18 15.5 18.3 14 18 13C19.2 12.3 20 11 20 9.5C20 7.5 18.5 5.8 17 5.5C16.5 3.5 14.5 2 12 2Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 2V22" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 8C9.5 9 10 11 10 13" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 8C14.5 9 14 11 14 13" />
          </svg>
        </div>
        <div class="nav-brand-text">
          <div class="nav-brand-name">Dr. Kanika</div>
          <p class="nav-brand-role">Neurologist</p>
        </div>
      </a>

      <!-- Desktop Links (visible from xl; CSS owns the display so utilities can't fight it) -->
      <nav class="nav-links" aria-label="Primary">
        {NAV_LINKS.map((link) => {
          const isActive = currentPage === link.href || (link.href !== '/' && currentPage.startsWith(link.href));
          return (
            <a
              href={`${import.meta.env.BASE_URL}${link.href.replace(/^\//, '')}`}
              aria-current={isActive ? "page" : undefined}
              class={`nav-link ${isActive ? 'is-active' : ''}`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Desktop Actions -->
      <div class="nav-actions">
        <button type="button" data-open-modal="booking" class="nav-cta-btn">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <span>Book Consultation</span>
          <span aria-hidden="true">→</span>
        </button>
      </div>

      <!-- Mobile Toggle -->
      <button
        type="button"
        id="mobile-menu-btn"
        class="nav-mobile-toggle flex xl:hidden"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>

    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="nav-mobile-menu hidden xl:hidden">
    <div class="nav-mobile-inner">
      {NAV_LINKS.map((link) => {
        const isActive = currentPage === link.href || (link.href !== '/' && currentPage.startsWith(link.href));
        return (
          <a
            href={`${import.meta.env.BASE_URL}${link.href.replace(/^\//, '')}`}
            aria-current={isActive ? "page" : undefined}
            class={`nav-mobile-link ${isActive ? 'is-active' : ''}`}
            data-nav-link
          >
            {link.label}
          </a>
        );
      })}
      
      <div class="nav-mobile-actions">
        <a href={phoneHref} class="btn btn-outline py-3 w-full justify-center rounded-xl">
          <PhoneIcon class="w-4 h-4" />
          Call Clinic
        </a>
        <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp py-3 w-full justify-center rounded-xl">
          <WhatsAppIcon class="w-4 h-4" />
          WhatsApp
        </a>
        <button type="button" data-open-modal="booking" class="nav-cta-btn w-full justify-center">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          Book Consultation
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const hamburger = document.getElementById("hamburger-icon");
  const closeIcon = document.getElementById("close-icon");

  if (menuBtn && menu && hamburger && closeIcon) {
    const isOpen = () => menuBtn.getAttribute("aria-expanded") === "true";

    function setOpen(open: boolean) {
      menuBtn!.setAttribute("aria-expanded", String(open));
      menuBtn!.setAttribute("aria-label", open ? "Close navigation menu" : "Open navigation menu");
      menu!.classList.toggle("hidden", !open);
      hamburger!.classList.toggle("hidden", open);
      closeIcon!.classList.toggle("hidden", !open);
    }

    menuBtn.addEventListener("click", () => setOpen(!isOpen()));

    // Close after choosing a destination so the next page isn't left with an open panel.
    menu.querySelectorAll("[data-nav-link]").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    // Escape always closes the panel (keyboard accessibility).
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen()) {
        setOpen(false);
        menuBtn.focus();
      }
    });

    // If the viewport grows past the mobile breakpoint, reset the panel state.
    const desktopQuery = window.matchMedia("(min-width: 1280px)");
    desktopQuery.addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>

