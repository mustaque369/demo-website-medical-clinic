---
import PhoneIcon from './icons/PhoneIcon.astro';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import CalendarIcon from './icons/CalendarIcon.astro';

interface Props {
  currentPage?: string;
}

const { currentPage = '/' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About Doctor' },
  { href: '/services', label: 'Services & Care' },
  { href: '/contact', label: 'Contact & Clinic' },
];

const phone = "+91 98765 43210";
const whatsapp = "https://wa.me/919876543210?text=" + encodeURIComponent("Hello Dr. Rajib Das Clinic, I would like to schedule an appointment.");
---

<!-- 1. Top Utility Header -->
<div class="bg-slate-900 text-slate-200 text-xs py-1.5 px-4 sm:px-6 lg:px-8 border-b border-slate-800">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
    
    <div class="flex items-center flex-wrap justify-center sm:justify-start gap-x-3.5 gap-y-1">
      <span class="inline-flex items-center text-teal-300 font-medium">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse mr-1.5" aria-hidden="true"></span>
        Accepting New Patients Today
      </span>
      <span class="hidden md:inline text-slate-600" aria-hidden="true">•</span>
      <span class="hidden md:flex items-center gap-1.5 text-slate-300">
        <svg class="w-3.5 h-3.5 text-teal-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Mon – Sat: 9:00 AM – 7:00 PM
      </span>
    </div>

    <!-- Contact triggers: call & WhatsApp icons sized identically (w-3) in equal badges -->
    <div class="flex items-center space-x-3 sm:space-x-4 text-xs font-medium">
      <a href={`tel:${phone}`} class="hover:text-teal-300 transition-colors flex items-center gap-1.5 text-slate-200 font-semibold group">
        <span class="w-5 h-5 rounded-full bg-slate-800 text-teal-400 border border-slate-700 flex items-center justify-center group-hover:bg-teal-600 group-hover:text-white group-hover:border-teal-600 transition shrink-0">
          <PhoneIcon class="w-3 h-3" />
        </span>
        <span>{phone}</span>
      </a>

      <span class="text-slate-700" aria-hidden="true">|</span>

      <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="hover:text-emerald-300 transition-colors flex items-center gap-1.5 text-slate-200 font-semibold group">
        <span class="w-5 h-5 rounded-full bg-[#25D366] text-white flex items-center justify-center group-hover:bg-[#1ebe5d] transition shrink-0 shadow-sm">
          <WhatsAppIcon class="w-3 h-3" />
        </span>
        <span>WhatsApp Clinic</span>
      </a>
    </div>

  </div>
</div>

<!-- 2. Main Sticky Navigation -->
<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow transition-all">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-[4.5rem]">
      
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-xl bg-teal-700 flex items-center justify-center shadow-xs group-hover:bg-teal-800 transition-colors text-white" aria-hidden="true">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
          </svg>
        </div>
        <div>
          <div class="font-extrabold text-base sm:text-lg tracking-tight text-slate-900 flex items-center gap-2">
            Dr. Rajib Das
            <span class="text-[11px] font-bold uppercase px-2 py-0.5 rounded-full bg-teal-50 text-teal-800 border border-teal-200">MBBS, MD</span>
          </div>
          <p class="text-[11.5px] text-slate-500 font-medium">Neurologist & Neurophysiologist</p>
        </div>
      </a>

      <nav class="hidden md:flex items-center space-x-1 lg:space-x-1.5" aria-label="Primary">
        {navLinks.map((link) => {
          const isActive = currentPage === link.href;
          return (
            <a
              href={link.href}
              aria-current={isActive ? 'page' : undefined}
              class={`px-3 py-1.5 rounded-lg text-sm font-semibold transition-all ${
                isActive
                  ? 'text-teal-800 bg-teal-50/90 border border-teal-200/80 font-bold'
                  : 'text-slate-600 hover:text-teal-800 hover:bg-slate-50'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Sticky desktop contact cluster: call + WhatsApp stay reachable after the top bar scrolls away -->
      <div class="hidden sm:flex items-center gap-2">
        <a
          href={`tel:${phone}`}
          aria-label="Call the clinic"
          class="w-9 h-9 rounded-xl border border-slate-200 bg-white text-teal-700 hover:border-teal-300 hover:bg-teal-50 flex items-center justify-center transition-all"
        >
          <PhoneIcon class="w-4 h-4" />
        </a>
        <a
          href={whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Chat with the clinic on WhatsApp"
          class="w-9 h-9 rounded-xl bg-[#25D366] text-white hover:bg-[#1ebe5d] flex items-center justify-center transition-all shadow-xs"
        >
          <WhatsAppIcon class="w-4 h-4" />
        </a>
        <a
          href={`${import.meta.env.BASE_URL}contact#book`
          class="inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-xl text-sm font-bold text-white bg-teal-700 hover:bg-teal-800 shadow-xs transition cursor-pointer"
        >
          <CalendarIcon class="w-3.5 h-3.5" />
          <span>Book Appointment</span>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex md:hidden">
        <button
          type="button"
          id="mobile-menu-btn"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="p-2 rounded-xl text-slate-600 hover:text-slate-900 hover:bg-slate-100"
        >
          <svg id="hamburger-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="close-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-b border-slate-200 px-4 pt-2 pb-5 space-y-1.5 shadow-md">
    {navLinks.map((link) => (
      <a
        href={link.href}
        aria-current={currentPage === link.href ? 'page' : undefined}
        class={`block px-3 py-2 rounded-lg text-sm font-semibold ${
          currentPage === link.href
            ? 'bg-teal-50 text-teal-800 border-l-4 border-teal-700'
            : 'text-slate-700 hover:bg-slate-50'
        }`}
      >
        {link.label}
      </a>
    ))}
    
    <div class="pt-3 border-t border-slate-100 grid grid-cols-2 gap-2">
      <a
        href={`tel:${phone}`}
        class="flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl bg-slate-100 text-slate-800 text-sm font-semibold hover:bg-slate-200"
      >
        <PhoneIcon class="w-3.5 h-3.5 text-teal-700" />
        <span>Call Doctor</span>
      </a>

      <button
        data-open-modal="booking"
        class="flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl bg-teal-700 text-white text-sm font-semibold hover:bg-teal-800 shadow-xs"
      >
        <CalendarIcon class="w-3.5 h-3.5" />
        <span>Book Visit</span>
      </button>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger-icon');
  const close = document.getElementById('close-icon');

  if (menuBtn && menu && hamburger && close) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', String(!isExpanded));
      if (isExpanded) {
        menu.classList.add('hidden');
        hamburger.classList.remove('hidden');
        close.classList.add('hidden');
      } else {
        menu.classList.remove('hidden');
        hamburger.classList.add('hidden');
        close.classList.remove('hidden');
      }
    });
  }
</script>
