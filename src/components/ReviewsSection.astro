---
import WhatsAppIcon from './icons/WhatsAppIcon.astro';

interface Props {
  headline?: string;
  subheadline?: string;
}

const {
  headline = "Patient Reviews & Recovery Stories",
  subheadline = "Verified experiences from patients receiving specialized neurological care under Dr. Rajib Das."
} = Astro.props;

const reviews = [
  {
    author: "Amitava Mukherjee",
    avatar: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=120&q=80",
    timeAgo: "2 weeks ago",
    tag: "Stroke Rehabilitation",
    text: "Dr. Rajib Das is truly exceptional. When my father had a minor stroke, Dr. Das provided quick diagnosis, reassuring explanation, and precise medication. His recovery has been miraculous."
  },
  {
    author: "Sunita Sharma",
    avatar: "https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=120&q=80",
    timeAgo: "1 month ago",
    tag: "Chronic Migraine",
    text: "After 7 years of severe recurring migraines, Dr. Das correctly identified my triggers and prescribed a targeted therapy. My episodes have dropped by over 80%. He is so attentive and patient."
  },
  {
    author: "Prabir Bhattacharya",
    avatar: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=120&q=80",
    timeAgo: "3 months ago",
    tag: "Parkinson's Care",
    text: "The clinic environment is calm and welcoming. Dr. Rajib Das spent 45 minutes listening to my mother's tremor issues. Her mobility and confidence have improved significantly under his care."
  },
  {
    author: "Meenakshi Sen",
    avatar: "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=120&q=80",
    timeAgo: "1 month ago",
    tag: "Diabetic Neuropathy",
    text: "I was suffering from burning sensations in my feet for two years. The EMG tests conducted by Dr. Das provided exact answers, and the treatment brought fast relief. Highly recommended!"
  },
  {
    author: "Dr. K. L. Banerjee",
    avatar: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=120&q=80",
    timeAgo: "2 months ago",
    tag: "Epilepsy Management",
    text: "As a fellow physician, I trust Dr. Rajib Das implicitly. His EEG evaluations and pharmacology adjustments for my daughter's seizure disorder have kept her completely seizure-free for over a year."
  },
  {
    author: "Rajeshwar Rao",
    avatar: "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=120&q=80",
    timeAgo: "3 weeks ago",
    tag: "Cervical Radiculopathy",
    text: "Severe shooting nerve pain down my right arm had made sleep impossible. Dr. Das diagnosed cervical nerve entrapment accurately without unnecessary surgery. Feeling 100% back to normal."
  }
];

// Rendered twice for a seamless marquee loop; the duplicate set is hidden from
// screen readers so each review is announced exactly once.
const marqueeSets = [0, 1];
---

<section class="section bg-cream border-t border-b border-slate-200 overflow-hidden relative" aria-label="Patient reviews">
  <div class="container-main mb-6">
    
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
      <div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-sm text-label border border-teal-200 mb-3">
          <svg class="w-3 h-3 text-amber-500 fill-amber-500" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          <span>Verified Google Reviews (4.9 / 5.0)</span>
        </div>
        <h2 class="text-h2 text-slate-900">{headline}</h2>
        <p class="text-caption text-slate-600 mt-0.5">{subheadline}</p>
      </div>

      <!-- Compact Trust Score Badge -->
      <div class="flex items-center gap-2.5 bg-white px-3.5 py-2 rounded-2xl border border-slate-200 shadow-xs shrink-0">
        <div class="text-h3 text-slate-900 leading-none">4.9</div>
        <div class="border-l border-slate-200 pl-2.5">
          <div class="flex text-amber-400 text-caption font-semibold leading-none" aria-hidden="true">★★★★★</div>
          <div class="text-caption font-medium text-slate-600 mt-0.5">248+ Google Reviews</div>
        </div>
      </div>
    </div>

  </div>

  <!-- Auto-scrolling review stream: pauses on hover/focus, frozen entirely under reduced-motion -->
  <div class="relative w-full overflow-hidden py-1">
    <div class="marquee-fade-l absolute left-0 top-0 bottom-0 w-16 sm:w-24 z-10 pointer-events-none" aria-hidden="true"></div>
    <div class="marquee-fade-r absolute right-0 top-0 bottom-0 w-16 sm:w-24 z-10 pointer-events-none" aria-hidden="true"></div>

    <div class="animate-marquee gap-4" role="group" aria-label="Scrolling patient reviews">
      {marqueeSets.map((setIndex) => (
        <div class="contents" aria-hidden={setIndex === 1 ? 'true' : undefined}>
          {reviews.map((rev) => (
            <div class="w-68 sm:w-76 shrink-0 bg-white rounded-2xl p-4 border border-slate-200 shadow-xs flex flex-col justify-between hover:border-teal-300 hover:shadow-sm transition-all">
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="text-label px-2.5 py-0.5 rounded-sm border border-teal-200">
                    {rev.tag}
                  </span>
                  <span class="text-caption text-slate-500 font-medium">{rev.timeAgo}</span>
                </div>

                <div class="flex text-amber-400 text-xs mb-1.5 leading-none" aria-label="5 out of 5 stars">
                  ★★★★★
                </div>

                <p class="text-body-sm text-slate-600 italic min-h-[4rem]">
                  "{rev.text}"
                </p>
              </div>

              <div class="pt-2.5 mt-2.5 border-t border-slate-100 flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <img
                    src={rev.avatar}
                    alt=""
                    width="24"
                    height="24"
                    class="w-6 h-6 rounded-full object-cover border border-slate-200"
                    loading="lazy"
                  />
                  <span class="text-body-sm font-semibold text-slate-800">{rev.author}</span>
                </div>
                <span class="text-caption font-semibold text-emerald-700 flex items-center gap-0.5">
                  <svg class="w-3 h-3 fill-current" viewBox="0 0 20 20" aria-hidden="true">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  Verified
                </span>
              </div>
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>
