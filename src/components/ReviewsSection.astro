---
import WhatsAppIcon from './icons/WhatsAppIcon.astro';

interface Props {
  headline?: string;
  subheadline?: string;
}

const {
  headline = "Patient Stories",
  subheadline = "Verified experiences from patients receiving specialized neurological care under Dr. Rajib Das."
} = Astro.props;

const reviews = [
  {
    author: "Amitava Mukherjee",
    avatar: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=120&q=80",
    timeAgo: "2 weeks ago",
    tag: "Stroke Rehabilitation",
    text: "Dr. Rajib Das is truly exceptional. When my father had a minor stroke, Dr. Das provided quick diagnosis, reassuring explanation, and precise medication. His recovery has been miraculous."
  },
  {
    author: "Sunita Sharma",
    avatar: "https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=120&q=80",
    timeAgo: "1 month ago",
    tag: "Chronic Migraine",
    text: "After 7 years of severe recurring migraines, Dr. Das correctly identified my triggers and prescribed a targeted therapy. My episodes have dropped by over 80%. He is so attentive and patient."
  },
  {
    author: "Prabir Bhattacharya",
    avatar: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=120&q=80",
    timeAgo: "3 months ago",
    tag: "Parkinson's Care",
    text: "The clinic environment is calm and welcoming. Dr. Rajib Das spent 45 minutes listening to my mother's tremor issues. Her mobility and confidence have improved significantly under his care."
  },
  {
    author: "Meenakshi Sen",
    avatar: "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=120&q=80",
    timeAgo: "1 month ago",
    tag: "Diabetic Neuropathy",
    text: "I was suffering from burning sensations in my feet for two years. The EMG tests conducted by Dr. Das provided exact answers, and the treatment brought fast relief. Highly recommended!"
  },
  {
    author: "Dr. K. L. Banerjee",
    avatar: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=120&q=80",
    timeAgo: "2 months ago",
    tag: "Epilepsy Management",
    text: "As a fellow physician, I trust Dr. Rajib Das implicitly. His EEG evaluations and pharmacology adjustments for my daughter's seizure disorder have kept her completely seizure-free for over a year."
  },
  {
    author: "Rajeshwar Rao",
    avatar: "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=120&q=80",
    timeAgo: "3 weeks ago",
    tag: "Cervical Radiculopathy",
    text: "Severe shooting nerve pain down my right arm had made sleep impossible. Dr. Das diagnosed cervical nerve entrapment accurately without unnecessary surgery. Feeling 100% back to normal."
  }
];
---

<section class="stories-section section bg-ivory border-t border-beige" aria-label="Patient Stories">
  <div class="container-main">

    <!-- Header -->
    <div class="stories-header reveal">
      <p class="stories-overline">Patient Stories</p>
      <h2 class="stories-title">The Path to Recovery</h2>
    </div>

    <!-- Editorial Story Carousel -->
    <div class="stories-carousel reveal" id="stories-carousel">
      
      <div class="stories-track" id="stories-track">
        {reviews.map((rev, index) => (
          <div 
            class={`story-slide ${index === 0 ? 'is-active' : ''}`} 
            data-index={index}
            aria-hidden={index === 0 ? "false" : "true"}
          >
            <!-- Large Quotation -->
            <blockquote class="story-quote">
              <p>"{rev.text}"</p>
            </blockquote>

            <!-- Attribution -->
            <div class="story-attribution">
              <span class="story-author">{rev.author}</span>
              <span class="story-meta">{rev.tag} &middot; {rev.timeAgo}</span>
            </div>
          </div>
        ))}
      </div>

      <!-- Minimal Controls -->
      <div class="stories-controls">
        <button class="story-btn story-prev" aria-label="Previous story">
          <span aria-hidden="true">&larr;</span>
        </button>
        <div class="story-indicators" aria-hidden="true">
          {reviews.map((_, idx) => (
            <span class={`story-dot ${idx === 0 ? 'is-active' : ''}`} data-index={idx}></span>
          ))}
        </div>
        <button class="story-btn story-next" aria-label="Next story">
          <span aria-hidden="true">&rarr;</span>
        </button>
      </div>

    </div>

  </div>
</section>

<script>
  // Simple editorial slider
  const track = document.getElementById('stories-track');
  if (track) {
    const slides = Array.from(track.querySelectorAll('.story-slide'));
    const dots = Array.from(document.querySelectorAll('.story-dot'));
    const prevBtn = document.querySelector('.story-prev');
    const nextBtn = document.querySelector('.story-next');
    
    let currentIndex = 0;
    const total = slides.length;
    let autoPlayInterval;

    function goToSlide(index) {
      if (index < 0) index = total - 1;
      if (index >= total) index = 0;
      
      slides.forEach((slide, i) => {
        if (i === index) {
          slide.classList.add('is-active');
          slide.setAttribute('aria-hidden', 'false');
        } else {
          slide.classList.remove('is-active');
          slide.setAttribute('aria-hidden', 'true');
        }
      });
      
      dots.forEach((dot, i) => {
        if (i === index) dot.classList.add('is-active');
        else dot.classList.remove('is-active');
      });
      
      currentIndex = index;
    }

    if (prevBtn && nextBtn) {
      prevBtn.addEventListener('click', () => {
        goToSlide(currentIndex - 1);
        resetAutoPlay();
      });
      
      nextBtn.addEventListener('click', () => {
        goToSlide(currentIndex + 1);
        resetAutoPlay();
      });
    }

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        goToSlide(i);
        resetAutoPlay();
      });
    });

    function startAutoPlay() {
      autoPlayInterval = setInterval(() => {
        goToSlide(currentIndex + 1);
      }, 7000); // 7s per story
    }

    function resetAutoPlay() {
      clearInterval(autoPlayInterval);
      startAutoPlay();
    }

    // Start auto-play only if not prefers-reduced-motion
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      startAutoPlay();
    }
  }
</script>
