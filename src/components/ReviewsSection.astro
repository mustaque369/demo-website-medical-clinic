---
interface Props {
  headline?: string;
  subheadline?: string;
}

const {
  headline = "What Our Patients Say",
  subheadline = "Real experiences from patients receiving specialized neurological care."
} = Astro.props;

const reviews = [
  {
    author: "Amitava Mukherjee",
    avatar: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=120&q=80",
    timeAgo: "2 weeks ago",
    tag: "Stroke Rehabilitation",
    text: "Dr. Rajib Das is truly exceptional. When my father had a minor stroke, Dr. Das provided quick diagnosis, reassuring explanation, and precise medication. His recovery has been miraculous."
  },
  {
    author: "Sunita Sharma",
    avatar: "https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=120&q=80",
    timeAgo: "1 month ago",
    tag: "Chronic Migraine",
    text: "After 7 years of severe recurring migraines, Dr. Das correctly identified my triggers and prescribed a targeted therapy. My episodes have dropped by over 80%. He is so attentive and patient."
  },
  {
    author: "Prabir Bhattacharya",
    avatar: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=120&q=80",
    timeAgo: "3 months ago",
    tag: "Parkinson's Care",
    text: "The clinic environment is calm and welcoming. Dr. Rajib Das spent 45 minutes listening to my mother's tremor issues. Her mobility and confidence have improved significantly under his care."
  },
  {
    author: "Meenakshi Sen",
    avatar: "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=120&q=80",
    timeAgo: "1 month ago",
    tag: "Diabetic Neuropathy",
    text: "I was suffering from burning sensations in my feet for two years. The EMG tests conducted by Dr. Das provided exact answers, and the treatment brought fast relief. Highly recommended!"
  },
  {
    author: "Dr. K. L. Banerjee",
    avatar: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=120&q=80",
    timeAgo: "2 months ago",
    tag: "Epilepsy Management",
    text: "As a fellow physician, I trust Dr. Rajib Das implicitly. His EEG evaluations and pharmacology adjustments for my daughter's seizure disorder have kept her completely seizure-free for over a year."
  },
  {
    author: "Rajeshwar Rao",
    avatar: "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=120&q=80",
    timeAgo: "3 weeks ago",
    tag: "Cervical Radiculopathy",
    text: "Severe shooting nerve pain down my right arm had made sleep impossible. Dr. Das diagnosed cervical nerve entrapment accurately without unnecessary surgery. Feeling 100% back to normal."
  }
];
---

<section id="reviews" class="section bg-slate-50 border-t border-slate-200" aria-label="Patient Reviews">

  <div class="container-main">
    
    <!-- Header -->
    <div class="text-center mb-12 md:mb-16 reveal">
      <div class="inline-flex items-center gap-2 mb-4 justify-center">
        <span class="text-teal-600 font-bold text-xs">★</span>
        <span class="text-label text-teal-700 tracking-[0.18em]">Patient Reviews</span>
      </div>
      <h2 class="text-h2 text-charcoal font-medium mb-3">{headline}</h2>
      <p class="text-body text-graphite max-w-2xl mx-auto">{subheadline}</p>
    </div>

    <!-- Reviews Carousel -->
    <div
      class="reviews-carousel relative"
      data-carousel
      role="region"
      aria-roledescription="carousel"
      aria-label="Patient reviews"
      tabindex="0"
    >
      <div class="reviews-track overflow-hidden" data-track>
        <div class="reviews-slider flex transition-transform duration-500 ease-out" data-slider>
          {reviews.map((rev, i) => (
            <div class="reviews-slide flex-shrink-0 w-full md:w-1/2 lg:w-1/3 px-3" data-slide>
              <div class="bg-white rounded-2xl border border-slate-200 p-6 h-full flex flex-col shadow-sm hover:shadow-md hover:border-teal-200 transition-all duration-300">
                <!-- Stars -->
                <div class="flex items-center gap-0.5 mb-4">
                  {[1,2,3,4,5].map(() => (
                    <svg class="w-4 h-4 text-amber-500 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                  ))}
                </div>
                <!-- Quote -->
                <p class="text-graphite text-body-sm leading-relaxed flex-1 mb-6">"{rev.text}"</p>
                <!-- Author -->
                <div class="flex items-center gap-3 pt-4 border-t border-slate-100 mt-auto">
                  <img src={rev.avatar} alt="" class="w-10 h-10 rounded-full object-cover border border-slate-200" loading="lazy" />
                  <div>
                    <p class="text-charcoal font-semibold text-sm">{rev.author}</p>
                    <p class="text-mist text-xs">{rev.tag} · {rev.timeAgo}</p>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Carousel Controls -->
      <div class="flex items-center justify-center gap-4 mt-8">
        <button type="button" class="review-prev w-11 h-11 rounded-full border border-slate-300 flex items-center justify-center text-slate-500 hover:border-teal-600 hover:text-teal-700 transition-colors" aria-label="Previous reviews" data-prev>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        </button>
        <div class="flex items-center" data-dots></div>
        <button type="button" class="review-next w-11 h-11 rounded-full border border-slate-300 flex items-center justify-center text-slate-500 hover:border-teal-600 hover:text-teal-700 transition-colors" aria-label="Next reviews" data-next>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>

  </div>
</section>

<script>
  // Runs after the deferred module executes, so the markup already exists.
  const carousel = document.querySelector<HTMLElement>('[data-carousel]');

  if (carousel) {
    const slider = carousel.querySelector<HTMLElement>('[data-slider]');
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-slide]'));
    const dotsContainer = carousel.querySelector<HTMLElement>('[data-dots]');
    const prevBtn = carousel.querySelector<HTMLButtonElement>('[data-prev]');
    const nextBtn = carousel.querySelector<HTMLButtonElement>('[data-next]');

    if (slider && slides.length > 0) {
      let currentIndex = 0;
      let slidesPerView = 1;

      const totalPages = () => Math.max(1, Math.ceil(slides.length / slidesPerView));

      function updateSlidesPerView() {
        if (window.innerWidth >= 1024) slidesPerView = 3;
        else if (window.innerWidth >= 768) slidesPerView = 2;
        else slidesPerView = 1;
      }

      function updateControls() {
        if (prevBtn) prevBtn.disabled = currentIndex === 0;
        if (nextBtn) nextBtn.disabled = currentIndex >= totalPages() - 1;
        if (!dotsContainer) return;
        Array.from(dotsContainer.children).forEach((child, i) => {
          const dot = child.querySelector<HTMLElement>('[data-dot-visual]');
          if (!dot) return;
          const active = i === currentIndex;
          dot.style.width = active ? '1.5rem' : '0.5rem';
          dot.style.backgroundColor = active
            ? 'var(--color-teal-700)'
            : 'var(--color-slate-300)';
          child.setAttribute('aria-current', active ? 'true' : 'false');
        });
      }

      function goTo(index: number) {
        currentIndex = Math.max(0, Math.min(index, totalPages() - 1));
        const slideWidth = slides[0].getBoundingClientRect().width;
        slider!.style.transform = `translateX(-${currentIndex * slidesPerView * slideWidth}px)`;
        updateControls();
      }

      function buildDots() {
        if (!dotsContainer) return;
        dotsContainer.innerHTML = '';
        for (let i = 0; i < totalPages(); i++) {
          const btn = document.createElement('button');
          btn.type = 'button';
          // Generous padding keeps the tap target usable on touch screens.
          btn.className = 'p-3 bg-transparent border-0 cursor-pointer flex items-center justify-center';
          btn.setAttribute('aria-label', `Go to reviews page ${i + 1}`);

          const dot = document.createElement('span');
          dot.setAttribute('data-dot-visual', '');
          dot.className = 'block h-2 rounded-full transition-all duration-300';
          dot.style.width = '0.5rem';
          dot.style.backgroundColor = 'var(--color-slate-300)';

          btn.appendChild(dot);
          btn.addEventListener('click', () => goTo(i));
          dotsContainer.appendChild(btn);
        }
      }

      function refresh() {
        updateSlidesPerView();
        buildDots();
        goTo(Math.min(currentIndex, totalPages() - 1));
      }

      refresh();

      prevBtn?.addEventListener('click', () => goTo(currentIndex - 1));
      nextBtn?.addEventListener('click', () => goTo(currentIndex + 1));

      // Keyboard support (the carousel region itself is focusable).
      carousel.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          goTo(currentIndex - 1);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          goTo(currentIndex + 1);
        }
      });

      // Touch / pointer swipe.
      let startX = 0;
      let isDragging = false;

      carousel.addEventListener('pointerdown', (e) => {
        if (e.pointerType === 'mouse') return;
        isDragging = true;
        startX = e.clientX;
      });

      const endDrag = (e: PointerEvent) => {
        if (!isDragging) return;
        isDragging = false;
        const delta = e.clientX - startX;
        if (Math.abs(delta) > 40) goTo(delta < 0 ? currentIndex + 1 : currentIndex - 1);
      };
      carousel.addEventListener('pointerup', endDrag);
      carousel.addEventListener('pointercancel', () => {
        isDragging = false;
      });

      let resizeTimer: number | undefined;
      window.addEventListener('resize', () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(refresh, 150);
      });
    }
  }
</script>
