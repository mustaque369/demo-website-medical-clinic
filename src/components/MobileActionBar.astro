---
import PhoneIcon from './icons/PhoneIcon.astro';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';

const phone = "+91 98765 43210";
const whatsapp = "https://wa.me/919876543210?text=" + encodeURIComponent("Hello Dr. Rajib Das Clinic, I need an urgent neurology consultation.");
---

<!-- Persistent Floating Mobile Action Bar: call & WhatsApp icons identically sized (w-3.5) -->
<div class="fixed bottom-0 left-0 right-0 z-50 md:hidden bg-white/95 backdrop-blur-lg border-t border-slate-200 p-2 shadow-[0_-4px_20px_rgba(0,0,0,0.06)]" role="region" aria-label="Quick contact actions">
  <div class="grid grid-cols-2 gap-2 max-w-md mx-auto">
    
    <a
      href={`tel:${phone}`}
      class="flex items-center justify-center gap-2 py-2.5 px-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm active:scale-95 transition shadow-xs"
      aria-label="Call the clinic directly"
    >
      <span class="w-5 h-5 rounded-full bg-slate-800 flex items-center justify-center text-teal-400 shrink-0" aria-hidden="true">
        <PhoneIcon class="w-3.5 h-3.5" />
      </span>
      <span>Call Doctor</span>
    </a>

    <a
      href={whatsapp}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-center gap-2 py-2.5 px-3.5 rounded-xl bg-[#25D366] hover:bg-[#1ebe5d] text-white font-bold text-sm active:scale-95 transition shadow-xs"
      aria-label="Chat with the clinic on WhatsApp"
    >
      <span class="w-5 h-5 rounded-full bg-white/20 flex items-center justify-center text-white shrink-0" aria-hidden="true">
        <WhatsAppIcon class="w-3.5 h-3.5" />
      </span>
      <span>WhatsApp</span>
    </a>

  </div>
</div>
