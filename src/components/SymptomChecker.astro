---
---

<section class="symptom-checker">
  <h2>Symptom Checker</h2>
  
  <div class="form-group">
    <label for="body-area">Select Body Area:</label>
    <select id="body-area">
      <option value="">-- Choose a body area --</option>
      <option value="head">Head</option>
      <option value="chest">Chest</option>
      <option value="abdomen">Abdomen</option>
      <option value="back">Back</option>
      <option value="limbs">Limbs</option>
    </select>
  </div>

  <div class="form-group">
    <label for="symptoms">Select Symptoms:</label>
    <select id="symptoms" disabled>
      <option value="">-- Select a body area first --</option>
    </select>
  </div>

  <div id="results" class="results"></div>
</section>

<script>
  const bodyAreaSelect = document.getElementById('body-area');
  const symptomsSelect = document.getElementById('symptoms');
  const resultsDiv = document.getElementById('results');

  const symptomsByArea = {
    head: [
      { value: 'headache', label: 'Headache' },
      { value: 'dizziness', label: 'Dizziness' },
      { value: 'vision', label: 'Vision Problems' }
    ],
    chest: [
      { value: 'chest-pain', label: 'Chest Pain' },
      { value: 'shortness-breath', label: 'Shortness of Breath' },
      { value: 'palpitations', label: 'Palpitations' }
    ],
    abdomen: [
      { value: 'abdominal-pain', label: 'Abdominal Pain' },
      { value: 'nausea', label: 'Nausea' },
      { value: 'bloating', label: 'Bloating' }
    ],
    back: [
      { value: 'lower-back-pain', label: 'Lower Back Pain' },
      { value: 'upper-back-pain', label: 'Upper Back Pain' },
      { value: 'stiffness', label: 'Stiffness' }
    ],
    limbs: [
      { value: 'joint-pain', label: 'Joint Pain' },
      { value: 'swelling', label: 'Swelling' },
      { value: 'numbness', label: 'Numbness' }
    ]
  };

  bodyAreaSelect.addEventListener('change', () => {
    const area = bodyAreaSelect.value;
    symptomsSelect.innerHTML = '<option value="">-- Select a symptom --</option>';
    
    if (area && symptomsByArea[area]) {
      symptomsByArea[area].forEach(symptom => {
        const option = document.createElement('option');
        option.value = symptom.value;
        option.textContent = symptom.label;
        symptomsSelect.appendChild(option);
      });
      symptomsSelect.disabled = false;
    } else {
      symptomsSelect.disabled = true;
    }
    resultsDiv.innerHTML = '';
  });

  symptomsSelect.addEventListener('change', () => {
    const symptom = symptomsSelect.value;
    const area = bodyAreaSelect.value;
    
    if (symptom) {
      resultsDiv.innerHTML = `
        <div class="result-card">
          <h3>Possible Conditions</h3>
          <p>Based on <strong>${symptomsByArea[area].find(s => s.value === symptom).label}</strong> in the <strong>${area}</strong> area:</p>
          <ul>
            <li>Condition A - Common cause</li>
            <li>Condition B - Less common</li>
            <li>Condition C - Rare but serious</li>
          </ul>
          <p class="disclaimer"><strong>Disclaimer:</strong> This is not medical advice. Please consult a healthcare professional.</p>
        </div>
      `;
    } else {
      resultsDiv.innerHTML = '';
    }
  });
</script>

<style>
  .symptom-checker {
    max-width: 600px;
    margin: 0 auto;
    padding: 1.5rem;
  }
  
  .form-group {
    margin-bottom: 1rem;
  }
  
  label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }
  
  select {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 1rem;
  }
  
  select:disabled {
    background-color: #f5f5f5;
    color: #999;
  }
  
  .results {
    margin-top: 1.5rem;
  }
  
  .result-card {
    background: #f8f9fa;
    border: 1px solid #e9ecef;
    border-radius: 8px;
    padding: 1rem;
  }
  
  .result-card h3 {
    margin-top: 0;
    color: #333;
  }
  
  .disclaimer {
    font-size: 0.875rem;
    color: #666;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid #e9ecef;
  }
</style>