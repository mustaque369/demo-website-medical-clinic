<!--
  Footer component with clinic info and contact details
-->
---
import { CLINIC } from '../constants';
import PhoneIcon from "./icons/PhoneIcon.astro";
import WhatsAppIcon from "./icons/WhatsAppIcon.astro";

const phoneHref = CLINIC.phoneHref;
const whatsapp = CLINIC.whatsappUrl;
---

<footer class="bg-slate-900 text-slate-300 border-t border-slate-800 pt-20 pb-12">
  <div class="container-main">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-10">
      
      <div class="space-y-3.5">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-teal-700 flex items-center justify-center text-white font-semibold shadow-xs" aria-hidden="true">
            RD
          </div>
          <div>
            <h3 class="text-h4 text-white">{CLINIC.doctor.name}</h3>
            <p class="text-caption text-teal-400 font-semibold">{CLINIC.doctor.qualifications}</p>
          </div>
        </div>
        <p class="text-body-sm text-slate-400">
          Senior Consultant Neurologist dedicated to precision diagnosis and patient-centered clinical care for brain, spine, and neuromuscular disorders.
        </p>
        <div class="pt-1">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-sm text-label-light text-emerald-400 border border-emerald-500/30">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400" aria-hidden="true"></span>
            Certified Clinical Neurologist
          </span>
        </div>
      </div>

      <nav aria-label="Footer">
        <h4 class="text-label-light text-white mb-3.5 border-l-2 border-teal-500 pl-2">Quick Navigation</h4>
        <ul class="space-y-2.5 text-body-sm list-none">
          <li><a href="/" class="text-slate-400 hover:text-teal-400 transition-colors">Home Page</a></li>
          <li><a href="/about" class="text-slate-400 hover:text-teal-400 transition-colors">Doctor Profile & Pedigree</a></li>
          <li><a href="/services" class="text-slate-400 hover:text-teal-400 transition-colors">Neurological Services & Diagnostics</a></li>
          <li><a href="/contact" class="text-slate-400 hover:text-teal-400 transition-colors">Clinic Location & Directions</a></li>
          <li><a href="/services#faq" class="text-slate-400 hover:text-teal-400 transition-colors">Patient FAQs</a></li>
        </ul>
      </nav>

      <div>
        <h4 class="text-label-light text-white mb-3.5 border-l-2 border-teal-500 pl-2">Specialized Care</h4>
        <ul class="space-y-2.5 text-body-sm text-slate-400 list-none">
          <li><a href="/services" class="hover:text-teal-400 transition-colors">Stroke & Brain Attack Recovery</a></li>
          <li><a href="/services" class="hover:text-teal-400 transition-colors">Chronic Migraine & Headache Clinic</a></li>
          <li><a href="/services" class="hover:text-teal-400 transition-colors">Epilepsy & Digital EEG Diagnostics</a></li>
          <li><a href="/services" class="hover:text-teal-400 transition-colors">Parkinson's & Tremor Management</a></li>
          <li><a href="/services" class="hover:text-teal-400 transition-colors">Neuropathy & EMG/NCV Testing</a></li>
          <li><a href="/services" class="hover:text-teal-400 transition-colors">Memory Loss & Dementia Screening</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-label-light text-white mb-3.5 border-l-2 border-teal-500 pl-2">Clinic Information</h4>
        <ul class="space-y-3 text-body-sm text-slate-400 list-none">
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-teal-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            </svg>
            <span>{CLINIC.address.full}</span>
          </li>
          <li class="flex items-center gap-2">
            <PhoneIcon class="w-4 h-4 text-teal-400 shrink-0" />
            <a href={phoneHref} class="hover:text-white transition-colors font-semibold text-slate-200">{CLINIC.phone}</a>
          </li>
          <li class="flex items-center gap-2">
            <span class="w-4 h-4 rounded-full bg-[#1da851] flex items-center justify-center text-white shrink-0" aria-hidden="true">
              <WhatsAppIcon class="w-2.5 h-2.5" />
            </span>
            <a
              href={whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              data-analytics-event="whatsapp_click"
              class="hover:text-emerald-400 transition-colors text-slate-300 font-medium"
            >
              WhatsApp Consultation Available
            </a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-teal-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>Mon – Sat: 9:00 AM – 7:00 PM</span>
          </li>
        </ul>
      </div>

    </div>

    <div class="border-t border-slate-800 pt-6 flex flex-col md:flex-row items-center justify-between text-caption text-slate-400 gap-3">
      <p>© {new Date().getFullYear()} Dr. Rajib Das, MBBS, MD (Neurology). All rights reserved.</p>
      <div class="flex items-center space-x-5">
        <a href="/contact" class="hover:text-white transition">Emergency Notice</a>
        <a href="/contact" class="hover:text-white transition">Patient Privacy</a>
        <a href="/contact" class="hover:text-white transition">Accessibility</a>
      </div>
    </div>
  </div>
</footer>