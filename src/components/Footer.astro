---
import { CLINIC } from '../constants';
import PhoneIcon from "./icons/PhoneIcon.astro";
import WhatsAppIcon from "./icons/WhatsAppIcon.astro";

const phoneHref = CLINIC.phoneHref;
const whatsapp = CLINIC.whatsappUrl;
---

<footer class="footer-section bg-charcoal text-white" aria-label="Site footer">
  <div class="container-main">
    <div class="footer-grid">
      
      <!-- Brand & About -->
      <div class="footer-brand-col">
        <div class="footer-logo" aria-hidden="true">
          <svg class="w-5 h-5 text-teal-deep" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
          </svg>
        </div>
        <div class="footer-brand-text">
          <h3 class="footer-brand-name">{CLINIC.doctor.name}</h3>
          <p class="footer-brand-role">{CLINIC.doctor.qualifications}</p>
        </div>
        <p class="footer-brand-desc">
          Senior Consultant Neurologist dedicated to precision diagnosis and patient-centered clinical care for brain, spine, and neuromuscular disorders.
        </p>
      </div>

      <!-- Links -->
      <nav class="footer-nav-col" aria-label="Quick links">
        <h4 class="footer-heading">Navigation</h4>
        <ul class="footer-list">
          <li><a href={import.meta.env.BASE_URL}>Home</a></li>
          <li><a href={`${import.meta.env.BASE_URL}about`}>Doctor Profile</a></li>
          <li><a href={`${import.meta.env.BASE_URL}services`}>Clinical Services</a></li>
          <li><a href={`${import.meta.env.BASE_URL}contact`}>Location &amp; Contact</a></li>
        </ul>
      </nav>

      <!-- Contact -->
      <div class="footer-contact-col">
        <h4 class="footer-heading">Connect</h4>
        <ul class="footer-list">
          <li>
            <a href={phoneHref} class="footer-contact-link">
              <span class="footer-icon-wrap" aria-hidden="true"><PhoneIcon class="w-3.5 h-3.5" /></span>
              {CLINIC.phone}
            </a>
          </li>
          <li>
            <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="footer-contact-link">
              <span class="footer-icon-wrap whatsapp-color" aria-hidden="true"><WhatsAppIcon class="w-3.5 h-3.5" /></span>
              WhatsApp Message
            </a>
          </li>
          <li class="footer-contact-text">
            Mon &ndash; Sat &middot; 9:00 AM &ndash; 7:00 PM
          </li>
        </ul>
      </div>

      <!-- Location -->
      <div class="footer-loc-col">
        <h4 class="footer-heading">Clinic Address</h4>
        <p class="footer-address">
          {CLINIC.address.full}
        </p>
        <a href="https://maps.google.com" target="_blank" rel="noopener noreferrer" class="footer-dir-link">
          Get Directions &rarr;
        </a>
      </div>

    </div>

    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} {CLINIC.doctor.name}. All rights reserved.</p>
    </div>
  </div>
</footer>

