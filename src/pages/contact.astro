---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import AppointmentModal from '../components/AppointmentModal.astro';
import PhoneIcon from '../components/icons/PhoneIcon.astro';
import WhatsAppIcon from '../components/icons/WhatsAppIcon.astro';
import CalendarIcon from '../components/icons/CalendarIcon.astro';

const phone = "+91 98765 43210";
const whatsapp = "https://wa.me/919876543210?text=" + encodeURIComponent("Hello Dr. Rajib Das Clinic, I would like to book a consultation.");
---

<Layout
  title="Contact Dr. Rajib Das Clinic | Location, OPD Hours & Booking"
  description="Contact Dr. Rajib Das, MBBS, MD (Neurology). Clinic address, interactive Google Maps directions, phone, WhatsApp, and online appointment request."
  currentPage="/contact"
>
  <Navbar currentPage="/contact" />

  <main id="main-content">
    <!-- Header Hero: single max-width (fixed former conflict) -->
    <section class="bg-gradient-to-b from-teal-50/50 via-white to-slate-50 py-12 sm:py-16 border-b border-slate-200">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
        <span class="text-xs font-bold uppercase tracking-wider text-teal-800 bg-teal-50 px-3 py-1 rounded-full border border-teal-200">
          Reach Our Clinic
        </span>
        <h1 class="text-3xl sm:text-4xl font-black text-slate-900 mt-3 tracking-tight font-serif">
          Appointments &amp; Clinic Location
        </h1>
        <p class="text-sm text-slate-600 mt-2.5 leading-relaxed">
          Schedule your consultation with Dr. Rajib Das, MBBS, MD (Neurology) or connect with our clinic patient support team directly.
        </p>
      </div>
    </section>

    <!-- Main Contact & Booking Grid -->
    <section class="py-14 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
          
          <!-- Clinic details & fast contact -->
          <div class="lg:col-span-5 space-y-5 reveal">
            
            <div class="bg-white rounded-2xl p-5 sm:p-7 border border-slate-200 shadow-xs space-y-5">
              <h2 class="text-lg font-black text-slate-900 border-b border-slate-100 pb-2.5 font-serif">Clinic Contact Information</h2>

              <div class="flex items-start gap-3.5">
                <div class="w-9 h-9 rounded-xl bg-teal-50 text-teal-800 flex items-center justify-center shrink-0 mt-0.5" aria-hidden="true">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="text-xs font-bold text-slate-900">Clinic Address</h3>
                  <p class="text-sm text-slate-600 mt-0.5 leading-relaxed">
                    Suite 402, Apex Neurosciences Center,<br/>
                    Park View Medical Enclave, Main Arterial Road,<br/>
                    Metro City, Pin 700001
                  </p>
                  <p class="text-xs text-slate-500 mt-0.5">Landmark: Opposite City Health Park, 4th Floor</p>
                </div>
              </div>

              <div class="flex items-start gap-3.5">
                <div class="w-9 h-9 rounded-xl bg-teal-50 text-teal-800 flex items-center justify-center shrink-0 mt-0.5" aria-hidden="true">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="text-xs font-bold text-slate-900">OPD Consultation Hours</h3>
                  <p class="text-sm text-slate-600 mt-0.5">Monday – Saturday: 9:00 AM – 7:00 PM</p>
                  <p class="text-xs text-slate-600">Sunday: Closed for Routine OPD (Emergency On-Call)</p>
                </div>
              </div>

              <div class="flex items-start gap-3.5">
                <div class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center shrink-0 mt-0.5" aria-hidden="true">
                  <PhoneIcon class="w-4 h-4" />
                </div>
                <div>
                  <h3 class="text-xs font-bold text-slate-900">Telephone / WhatsApp</h3>
                  <p class="text-sm text-slate-600 mt-0.5">
                    Direct Line: <a href={`tel:${phone}`} class="font-bold text-teal-800 hover:underline">{phone}</a>
                  </p>
                  <p class="text-xs text-slate-600 mt-0.5">WhatsApp inquiries answered promptly</p>
                </div>
              </div>

              <div class="pt-3 border-t border-slate-100 flex flex-col sm:flex-row gap-2.5">
                <a
                  href={`tel:${phone}`}
                  class="flex-1 py-2.5 px-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm text-center transition flex items-center justify-center gap-1.5"
                >
                  <span class="w-4 h-4 rounded-full bg-slate-700 flex items-center justify-center text-teal-400 shrink-0" aria-hidden="true">
                    <PhoneIcon class="w-2.5 h-2.5" />
                  </span>
                  <span>Call {phone}</span>
                </a>
                <a
                  href={whatsapp}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 py-2.5 px-3.5 rounded-xl bg-[#25D366] hover:bg-[#1ebe5d] text-white font-bold text-sm text-center shadow-xs transition flex items-center justify-center gap-1.5"
                >
                  <span class="w-4 h-4 rounded-full bg-white/20 flex items-center justify-center text-white shrink-0" aria-hidden="true">
                    <WhatsAppIcon class="w-2.5 h-2.5" />
                  </span>
                  <span>WhatsApp Doctor</span>
                </a>
              </div>

            </div>

            <!-- Emergency card -->
            <div class="bg-amber-50 rounded-2xl p-5 border border-amber-200">
              <h3 class="font-bold text-amber-900 text-sm flex items-center gap-1.5 font-serif">
                <svg class="w-3.5 h-3.5 text-amber-600" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                </svg>
                <span>Acute Emergency Protocol</span>
              </h3>
              <p class="text-xs text-amber-800 mt-1 leading-relaxed">
                If the patient is experiencing sudden paralysis, acute slurred speech, active prolonged seizures, or loss of consciousness, please proceed to the nearest emergency medical facility immediately.
              </p>
            </div>

          </div>

          <!-- Appointment form -->
          <div class="lg:col-span-7" id="book">
            <div class="bg-white rounded-2xl p-5 sm:p-7 border border-slate-200 shadow-xs reveal">
              
              <div class="mb-5">
                <span class="text-[11px] font-bold uppercase tracking-wider text-teal-800 bg-teal-50 px-2.5 py-1 rounded-full border border-teal-100">
                  Online Scheduling
                </span>
                <h2 class="text-xl font-black text-slate-900 mt-1.5 font-serif">Book a Consultation Slot</h2>
                <p class="text-xs text-slate-600 mt-0.5">Fill out the details below. Our staff will confirm your slot via call / WhatsApp.</p>
              </div>

              <noscript>
                <div class="mb-4 p-3 rounded-xl bg-amber-50 border border-amber-200 text-xs text-amber-800">
                  Online form needs JavaScript. Please call <a href={`tel:${phone}`} class="font-bold underline">{phone}</a> or use the WhatsApp button to book.
                </div>
              </noscript>

              <form id="contact-booking-form" class="space-y-3.5">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                  <div>
                    <label for="contact-name" class="block text-xs font-bold text-slate-700 mb-1">Patient Full Name *</label>
                    <input
                      type="text"
                      id="contact-name"
                      name="patient-name"
                      required
                      autocomplete="name"
                      placeholder="e.g. Anand Sen"
                      class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-sm text-slate-900 focus:bg-white focus:outline-none focus:border-teal-600"
                    />
                  </div>

                  <div>
                    <label for="contact-age" class="block text-xs font-bold text-slate-700 mb-1">Patient Age</label>
                    <input
                      type="number"
                      id="contact-age"
                      name="patient-age"
                      min="0"
                      max="120"
                      placeholder="e.g. 52"
                      class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-sm text-slate-900 focus:bg-white focus:outline-none focus:border-teal-600"
                    />
                  </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                  <div>
                    <label for="contact-phone" class="block text-xs font-bold text-slate-700 mb-1">Phone / WhatsApp Number *</label>
                    <input
                      type="tel"
                      id="contact-phone"
                      name="patient-phone"
                      required
                      autocomplete="tel"
                      placeholder="+91 98765 XXXXX"
                      class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-sm text-slate-900 focus:bg-white focus:outline-none focus:border-teal-600"
                    />
                  </div>

                  <div>
                    <label for="contact-specialty" class="block text-xs font-bold text-slate-700 mb-1">Primary Reason for Visit *</label>
                    <select
                      id="contact-specialty"
                      name="reason"
                      class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-sm text-slate-900 focus:bg-white focus:outline-none focus:border-teal-600"
                    >
                      <option value="Stroke & Brain Recovery">Stroke &amp; Brain Recovery</option>
                      <option value="Severe Migraine / Headache">Severe Migraine / Headache</option>
                      <option value="Epilepsy & Seizures">Epilepsy &amp; Seizures</option>
                      <option value="Parkinson's & Tremors">Parkinson's &amp; Tremors</option>
                      <option value="Neuropathy & Nerve Pain">Neuropathy &amp; Nerve Pain</option>
                      <option value="Memory Loss & Dementia">Memory Loss &amp; Dementia</option>
                      <option value="EEG / EMG Diagnostics Test">EEG / EMG Diagnostic Study</option>
                      <option value="General Second Opinion">General Second Opinion</option>
                    </select>
                  </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                  <div>
                    <label for="contact-date" class="block text-xs font-bold text-slate-700 mb-1">Preferred Date</label>
                    <input
                      type="date"
                      id="contact-date"
                      name="preferred-date"
                      class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-sm text-slate-900 focus:bg-white focus:outline-none focus:border-teal-600"
                    />
                  </div>

                  <div>
                    <label for="contact-time" class="block text-xs font-bold text-slate-700 mb-1">Preferred Time Window</label>
                    <select
                      id="contact-time"
                      name="preferred-time"
                      class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-sm text-slate-900 focus:bg-white focus:outline-none focus:border-teal-600"
                    >
                      <option value="Morning (10:00 AM - 01:00 PM)">Morning (10:00 AM – 01:00 PM)</option>
                      <option value="Afternoon (02:00 PM - 05:00 PM)">Afternoon (02:00 PM – 05:00 PM)</option>
                      <option value="Evening (05:00 PM - 07:00 PM)">Evening (05:00 PM – 07:00 PM)</option>
                    </select>
                  </div>
                </div>

                <div>
                  <label for="contact-notes" class="block text-xs font-bold text-slate-700 mb-1">Brief Symptoms / Notes (Optional)</label>
                  <textarea
                    id="contact-notes"
                    name="notes"
                    rows="3"
                    placeholder="Duration of symptoms, previous scan reports, or specific concerns..."
                    class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-sm text-slate-900 focus:bg-white focus:outline-none focus:border-teal-600"
                  ></textarea>
                </div>

                <button
                  type="submit"
                  class="w-full py-3 px-5 rounded-xl text-white font-bold text-sm bg-teal-700 hover:bg-teal-800 shadow-xs transition cursor-pointer flex items-center justify-center gap-2"
                >
                  <span class="w-5 h-5 rounded-full bg-[#25D366] flex items-center justify-center text-white shrink-0" aria-hidden="true">
                    <WhatsAppIcon class="w-3 h-3" />
                  </span>
                  <span>Confirm &amp; Send Request via WhatsApp</span>
                </button>

                <p class="text-center text-xs text-slate-600">
                  Your medical privacy is strictly maintained. We never share patient details with third parties.
                </p>
              </form>

            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- Location & Google Map (branded card header) -->
    <section class="py-14 bg-white border-t border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="max-w-3xl mb-6 reveal">
          <span class="text-xs font-bold uppercase tracking-wider text-teal-800 bg-teal-50 px-3 py-1 rounded-full border border-teal-200">
            Directions &amp; Access
          </span>
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 mt-1.5 font-serif">Clinic Location &amp; Transit Guide</h2>
          <p class="text-slate-600 text-sm mt-0.5">Conveniently reachable by metro, cab, and private vehicles.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
          
          <div class="lg:col-span-8 reveal">
            <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-sm bg-white">
              <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-3 border-b border-slate-200 bg-slate-50">
                <div class="flex items-center gap-2.5 min-w-0">
                  <span class="w-8 h-8 rounded-lg bg-teal-700 text-white flex items-center justify-center shrink-0" aria-hidden="true">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    </svg>
                  </span>
                  <div class="min-w-0">
                    <p class="text-xs font-bold text-slate-900 truncate">Apex Neurosciences Center</p>
                    <p class="text-xs text-slate-600 truncate">Park View Medical Enclave, Metro City 700001</p>
                  </div>
                </div>
                <a
                  href="https://maps.google.com"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs font-bold text-teal-700 hover:text-teal-900 flex items-center gap-1 shrink-0"
                >
                  Get Directions <span aria-hidden="true">↗</span>
                </a>
              </div>
              <iframe
                title="Google Maps location of Dr Rajib Das Clinic"
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d117925.21689648937!2d88.26495046206148!3d22.535564937497746!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x39f882db4908f667%3A0x43e330e68f6c2cbc!2sKolkata%2C%20West%20Bengal!5e0!3m2!1sen!2sin!4v1700000000000!5m2!1sen!2sin"
                width="100%"
                height="350"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                class="w-full block"
              ></iframe>
            </div>
          </div>

          <div class="lg:col-span-4 space-y-3 text-xs reveal">
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
              <h3 class="font-bold text-slate-900 mb-0.5 flex items-center gap-1.5 font-serif">
                <span class="w-1.5 h-1.5 rounded-full bg-teal-700" aria-hidden="true"></span>
                Wheelchair &amp; Elevator Access
              </h3>
              <p class="text-slate-600">Level entrance ramp at the main reception gate and wide stretcher elevators directly to the 4th floor.</p>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
              <h3 class="font-bold text-slate-900 mb-0.5 flex items-center gap-1.5 font-serif">
                <span class="w-1.5 h-1.5 rounded-full bg-teal-700" aria-hidden="true"></span>
                Patient Parking
              </h3>
              <p class="text-slate-600">Dedicated basement valet and self-parking spaces allocated for all registered patients.</p>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
              <h3 class="font-bold text-slate-900 mb-0.5 flex items-center gap-1.5 font-serif">
                <span class="w-1.5 h-1.5 rounded-full bg-teal-700" aria-hidden="true"></span>
                Metro &amp; Transit
              </h3>
              <p class="text-slate-600">Situated 400 meters from Central Medical Metro Station, with taxi ranks and auto stands right outside.</p>
            </div>

            <a
              href="https://maps.google.com"
              target="_blank"
              rel="noopener noreferrer"
              class="block w-full text-center py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm transition"
            >
              Get Turn-by-Turn Directions →
            </a>
          </div>

        </div>

      </div>
    </section>

  </main>

  <Footer />
  <MobileActionBar />
  <AppointmentModal />
</Layout>

<script>
  const form = document.getElementById('contact-booking-form') as HTMLFormElement | null;

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('contact-name') as HTMLInputElement)?.value || '';
      const age = (document.getElementById('contact-age') as HTMLInputElement)?.value || 'N/A';
      const phone = (document.getElementById('contact-phone') as HTMLInputElement)?.value || '';
      const specialty = (document.getElementById('contact-specialty') as HTMLSelectElement)?.value || '';
      const date = (document.getElementById('contact-date') as HTMLInputElement)?.value || 'Earliest';
      const time = (document.getElementById('contact-time') as HTMLSelectElement)?.value || '';
      const notes = (document.getElementById('contact-notes') as HTMLTextAreaElement)?.value || 'None';

      const msg = `Hello Dr. Rajib Das Clinic,\n\nI want to schedule an appointment:\n- Patient: ${name} (Age: ${age})\n- Phone: ${phone}\n- Specialty: ${specialty}\n- Preferred Date & Time: ${date} (${time})\n- Symptoms/Notes: ${notes}`;
      const url = `https://wa.me/919876543210?text=${encodeURIComponent(msg)}`;
      window.open(url, '_blank');
    });
  }
</script>
