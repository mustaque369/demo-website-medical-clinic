---
import { ANALYTICS } from '../constants/analytics';
import { CLINIC, whatsappLink } from '../constants';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import AppointmentModal from '../components/AppointmentModal.astro';
import PhoneIcon from '../components/icons/PhoneIcon.astro';
import WhatsAppIcon from '../components/icons/WhatsAppIcon.astro';

const phoneHref = CLINIC.phoneHref;
const whatsapp = whatsappLink();

const credentials = [
  {
    degree: "MBBS (Distinction & Gold Medal)",
    institution: "Premier Medical College & Hospital",
    year: "Honors Graduate",
    desc: "Rigorous clinical medical foundation with comprehensive internal medicine and neurology clinical rotations."
  },
  {
    degree: "MD in Neurology",
    institution: "National Apex Institute of Medical Sciences",
    year: "Board Certified Neurologist",
    desc: "Advanced specialty training in clinical neurology, acute neurovascular intervention, and electrophysiology."
  },
  {
    degree: "Clinical Fellowship in Stroke & Neurocritical Care",
    institution: "International Center for Neurological Sciences",
    year: "Advanced Fellow",
    desc: "Intensive training in acute stroke thrombolysis, mechanical thrombectomy management, and secondary brain care."
  },
  {
    degree: "Certified Clinical Neurophysiologist",
    institution: "Electrophysiology Board",
    year: "Specialist Certification",
    desc: "Specialized expertise in recording and diagnostic interpretation of Digital Video EEG, EMG, and Evoked Potentials."
  }
];

const milestones = [
  { count: "15+", label: "Years of Practice" },
  { count: "12,500+", label: "Patients Treated" },
  { count: "3,800+", label: "EEG / EMG Studies" },
  { count: "25+", label: "Clinical Publications" }
];
---

<Layout
  title="About Dr. Kanika | MBBS, MD (Neurology) | Neurologist Profile"
  description="Learn about Dr. Kanika, MBBS, MD (Neurology), fellowship background, clinical experience, memberships, and patient care philosophy."
  currentPage="/about"
  plausibleDomain={ANALYTICS.plausibleDomain}
  ga4Id={ANALYTICS.ga4MeasurementId}
  enableConsentBanner={ANALYTICS.enableConsentBanner}
>
  <Navbar currentPage="/about" />

  <main id="main-content">

    <!-- -----------------------------------------------------------
         EDITORIAL DOCTOR PROFILE — full-width cinematic header
         ----------------------------------------------------------- -->
    <section class="doc-profile-hero section border-b border-beige" aria-label="Doctor profile">
      <div class="container-main">
        <div class="doc-profile-grid">

          <!-- Portrait column -->
          <div class="doc-portrait-col reveal">
            <div class="doc-portrait-frame">
              <img
                src="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&q=80&w=800"
                alt="Dr. Kanika, Consultant Neurologist and Clinical Neurophysiologist"
                width="800"
                height="960"
                class="doc-portrait-img"
                loading="eager"
                fetchpriority="high"
              />
              <!-- Cinematic grade overlay -->
              <div class="doc-portrait-overlay" aria-hidden="true"></div>
            </div>
          </div>

          <!-- Identity + bio column -->
          <div class="doc-identity-col reveal">

            <!-- Eyebrow -->
            <p class="doc-eyebrow">Physician Profile</p>

            <!-- Name -->
            <h1 class="doc-name">Dr. Kanika</h1>

            <p class="doc-credentials">MBBS (Distinction &amp; Gold Medal) &middot; MD in Neurology</p>
            <p class="doc-role">Consultant Neurologist &amp; Certified Clinical Neurophysiologist</p>

            <!-- Thin rule -->
            <hr class="doc-rule" />

            <!-- Biography paragraphs — verbatim factual content -->
            <div class="doc-bio">
              <p>
                Dr. Kanika is an accomplished Senior Neurologist known for Her analytical diagnostic approach and patient-centered communication with individuals facing complex neurological conditions.
              </p>
              <p>
                With more than 15 years in active clinical neurology practice, Dr. Das has treated patients dealing with acute stroke recovery, refractory migraine, intractable epilepsy, Parkinson's disease, and peripheral nerve disorders.
              </p>
            </div>

            <!-- Philosophy pull-quote — verbatim from existing content -->
            <blockquote class="doc-philosophy">
              <p>"In neurology, an illness rarely affects an isolated organ — it impacts an individual's independence, speech, mobility, and identity. Every patient deserves time, rigorous diagnostic inquiry, and complete reassurance on their treatment path."</p>
            </blockquote>

            <!-- Practice statistics — pure typography, no cards -->
            <div class="doc-stats">
              {milestones.map((m, i) => (
                <div class="doc-stat">
                  <span class="doc-stat-num">{m.count}</span>
                  <span class="doc-stat-label">{m.label}</span>
                </div>
              ))}
            </div>

            <!-- CTA row -->
            <div class="doc-cta-row">
              <button type="button" data-open-modal="booking" class="btn btn-teal px-8 py-3.5">
                Book a Consultation
              </button>
              <a href={phoneHref} class="doc-phone-link">
                <span class="doc-phone-icon" aria-hidden="true">
                  <PhoneIcon class="w-4 h-4" />
                </span>
                {CLINIC.phone}
              </a>
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- -----------------------------------------------------------
         CREDENTIALS — editorial list, no cards
         ----------------------------------------------------------- -->
    <section class="section bg-ivory border-b border-beige" aria-label="Qualifications and credentials">
      <div class="container-main">

        <div class="doc-section-header reveal">
          <p class="doc-section-overline">Academic Pedigree</p>
          <h2 class="doc-section-title">Education, Fellowships &amp; Accreditations</h2>
        </div>

                  <ol class="doc-credential-list flex flex-col gap-8" aria-label="Qualifications list">
            {credentials.map((item, idx) => {
              const images = [
                "https://images.unsplash.com/photo-1546410531-bb4caa6b424d?auto=format&fit=crop&w=200&q=80",
                "https://images.unsplash.com/photo-1576091160550-2173dba999ef?auto=format&fit=crop&w=200&q=80",
                "https://images.unsplash.com/photo-1581056771107-24ca5f033842?auto=format&fit=crop&w=200&q=80",
                "https://images.unsplash.com/photo-1551076805-e1869033e561?auto=format&fit=crop&w=200&q=80"
              ];
              return (
                <li class="doc-credential-item reveal flex gap-6 items-start bg-white p-6 rounded-2xl shadow-[0_4px_20px_-4px_rgba(15,23,42,0.05)] border border-slate-100" style={`transition-delay: ${idx * 80}ms`}>
                  <img src={images[idx]} alt="Academic Image" class="w-20 h-20 md:w-28 md:h-28 rounded-xl object-cover shadow-sm shrink-0" />
                  <div class="doc-credential-body flex-1">
                    <div class="doc-credential-meta flex flex-wrap gap-2 items-center mb-2">
                      <h3 class="doc-credential-degree text-lg md:text-xl font-bold text-slate-900">{item.degree}</h3>
                      <span class="doc-credential-badge text-xs font-semibold bg-teal-50 text-teal-700 px-3 py-1 rounded-full">{item.year}</span>
                    </div>
                    <p class="doc-credential-institution text-slate-700 font-semibold mb-2">{item.institution}</p>
                    <p class="doc-credential-desc text-slate-600 text-sm leading-relaxed">{item.desc}</p>
                  </div>
                </li>
              );
            })}
          </ol>

      </div>
    </section>

    <!-- -----------------------------------------------------------
         MEMBERSHIPS — horizontal typography list, no icon cards
         ----------------------------------------------------------- -->
    <section class="section bg-white border-b border-beige" aria-label="Professional memberships">
      <div class="container-main">

        <div class="doc-section-header reveal">
          <p class="doc-section-overline">Affiliations</p>
          <h2 class="doc-section-title">Professional Memberships</h2>
        </div>

                  <ul class="grid grid-cols-1 md:grid-cols-2 gap-6 reveal" aria-label="Memberships">
            <li class="doc-membership-item flex items-center gap-4 bg-slate-50 p-6 rounded-2xl border border-slate-100">
              <img src="https://images.unsplash.com/photo-1559757175-5700dde675bc?auto=format&fit=crop&w=150&q=80" alt="NSI" class="w-16 h-16 rounded-full object-cover shadow-sm shrink-0" />
              <div>
                <p class="font-bold text-slate-900">Neurological Society of India</p>
                <p class="text-sm text-slate-600">Life Member &amp; Contributor</p>
              </div>
            </li>
            <li class="doc-membership-item flex items-center gap-4 bg-slate-50 p-6 rounded-2xl border border-slate-100">
              <img src="https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=150&q=80" alt="AAN" class="w-16 h-16 rounded-full object-cover shadow-sm shrink-0" />
              <div>
                <p class="font-bold text-slate-900">American Academy of Neurology</p>
                <p class="text-sm text-slate-600">International Member</p>
              </div>
            </li>
            <li class="doc-membership-item flex items-center gap-4 bg-slate-50 p-6 rounded-2xl border border-slate-100">
              <img src="https://images.unsplash.com/photo-1532938911079-1b06ac7ceec7?auto=format&fit=crop&w=150&q=80" alt="IES" class="w-16 h-16 rounded-full object-cover shadow-sm shrink-0" />
              <div>
                <p class="font-bold text-slate-900">Indian Epilepsy Society</p>
                <p class="text-sm text-slate-600">Clinical Researcher</p>
              </div>
            </li>
            <li class="doc-membership-item flex items-center gap-4 bg-slate-50 p-6 rounded-2xl border border-slate-100">
              <img src="https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&w=150&q=80" alt="WSO" class="w-16 h-16 rounded-full object-cover shadow-sm shrink-0" />
              <div>
                <p class="font-bold text-slate-900">World Stroke Organization</p>
                <p class="text-sm text-slate-600">Certified Stroke Protocol Member</p>
              </div>
            </li>
          </ul>

      </div>
    </section>

    <!-- -----------------------------------------------------------
         CLINIC ENVIRONMENT — photography grid
         ----------------------------------------------------------- -->
    <section class="section bg-ivory" aria-label="Clinic environment">
      <div class="container-main">
        <div class="doc-section-header reveal">
          <p class="doc-section-overline">The Environment</p>
          <h2 class="doc-section-title">Patient-First Modern Facilities</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          <div class="img-frame aspect-4/3 relative group reveal">
            <img
              src="https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?auto=format&fit=crop&w=600&q=80"
              alt="Doctor consultation suite"
              width="600"
              height="450"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="img-scrim absolute inset-0 flex items-end p-4" aria-hidden="true">
              <span class="text-h5 text-white">Doctor Consultation Suite</span>
            </div>
          </div>

          <div class="img-frame aspect-4/3 relative group reveal" style="transition-delay: 80ms">
            <img
              src="https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&w=600&q=80"
              alt="Digital EEG electrophysiology lab"
              width="600"
              height="450"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="img-scrim absolute inset-0 flex items-end p-4" aria-hidden="true">
              <span class="text-h5 text-white">Digital EEG &amp; EMG Suite</span>
            </div>
          </div>

          <div class="img-frame aspect-4/3 relative group reveal" style="transition-delay: 160ms">
            <img
              src="https://images.unsplash.com/photo-1584515979956-d9f6e5d09982?auto=format&fit=crop&w=600&q=80"
              alt="Neuro-rehabilitation recovery area"
              width="600"
              height="450"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="img-scrim absolute inset-0 flex items-end p-4" aria-hidden="true">
              <span class="text-h5 text-white">Neuro-Rehabilitation Bay</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <ReviewsSection
      headline="Verified Patient Experiences"
      subheadline="Patients share their recovery journeys with Dr. Kanika across complex neurological conditions."
    />

    <!-- Consultation CTA -->
    <section class="conversion-section section bg-ivory" aria-label="Take the next step">
      <div class="container-narrow reveal text-center">
        
        <p class="conversion-overline">Consultation</p>
        <h2 class="conversion-title">Take the next step.</h2>
        <p class="conversion-desc">Schedule an in-depth neurological evaluation. Take the first step toward accurate diagnosis and targeted relief.</p>

        <div class="conversion-actions">
          <button type="button" data-open-modal="booking" class="btn btn-teal px-8 py-3.5 text-base">
            Request Appointment
          </button>
          
          <div class="conversion-secondary">
            <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="conversion-link">
              <span class="conversion-icon whatsapp-color" aria-hidden="true">
                <WhatsAppIcon class="w-6 h-6" />
              </span>
              WhatsApp Message
            </a>
            <span class="conversion-divider" aria-hidden="true"></span>
            <a href={phoneHref} class="conversion-link">
              <span class="conversion-icon" aria-hidden="true">
                <PhoneIcon class="w-4 h-4" />
              </span>
              {CLINIC.phone}
            </a>
          </div>
        </div>

        <p class="conversion-meta">Monday &ndash; Saturday &middot; 9:00 AM &ndash; 7:00 PM</p>
      </div>
    </section>
  </main>

  <Footer />
  <MobileActionBar />
  <AppointmentModal />
</Layout>



