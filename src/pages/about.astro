---
import { ANALYTICS } from '../constants/analytics';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import AppointmentModal from '../components/AppointmentModal.astro';
import PhoneIcon from '../components/icons/PhoneIcon.astro';
import WhatsAppIcon from '../components/icons/WhatsAppIcon.astro';
import CalendarIcon from '../components/icons/CalendarIcon.astro';

const phone = "+91 98765 43210";
const whatsapp = "https://wa.me/919876543210?text=" + encodeURIComponent("Hello Dr. Rajib Das Clinic, I would like to schedule an appointment.");

const credentials = [
  {
    degree: "MBBS (Distinction & Gold Medal)",
    institution: "Premier Medical College & Hospital",
    year: "Honors Graduate",
    desc: "Rigorous clinical medical foundation with comprehensive internal medicine and neurology clinical rotations."
  },
  {
    degree: "MD in Neurology",
    institution: "National Apex Institute of Medical Sciences",
    year: "Board Certified Neurologist",
    desc: "Advanced specialty training in clinical neurology, acute neurovascular intervention, and electrophysiology."
  },
  {
    degree: "Clinical Fellowship in Stroke & Neurocritical Care",
    institution: "International Center for Neurological Sciences",
    year: "Advanced Fellow",
    desc: "Intensive training in acute stroke thrombolysis, mechanical thrombectomy management, and secondary brain care."
  },
  {
    degree: "Certified Clinical Neurophysiologist",
    institution: "Electrophysiology Board",
    year: "Specialist Certification",
    desc: "Specialized expertise in recording and diagnostic interpretation of Digital Video EEG, EMG, and Evoked Potentials."
  }
];

const milestones = [
  { count: "15+", label: "Years of Practice" },
  { count: "12,500+", label: "Patients Treated" },
  { count: "3,800+", label: "EEG / EMG Studies" },
  { count: "25+", label: "Clinical Publications" }
];
---

<Layout
  plausibleDomain={ANALYTICS.plausibleDomain}
  ga4Id={ANALYTICS.ga4MeasurementId}
  enableConsentBanner={ANALYTICS.enableConsentBanner}
  title="About Dr. Rajib Das | MBBS, MD (Neurology) | Neurologist Profile"
  description="Learn about Dr. Rajib Das, MBBS, MD (Neurology), fellowship background, clinical experience, memberships, and patient care philosophy."
  currentPage="/about"
>
  <Navbar currentPage="/about" />

  <main id="main-content">
    <!-- Doctor Profile Header -->
    <section class="bg-gradient-to-b from-teal-50/50 via-white to-slate-50 py-14 sm:py-18 border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          
          <div class="lg:col-span-5">
            <div class="relative max-w-sm mx-auto">
              <div class="bg-white rounded-3xl p-5 border border-slate-200 shadow-lg text-center">
                
                <div class="relative w-44 h-44 rounded-2xl overflow-hidden mx-auto mb-4 bg-slate-100 shadow-xs">
                  <img
                    src="https://images.unsplash.com/photo-1622253692010-333f2da6031d?auto=format&fit=crop&w=500&q=80"
                    alt="Portrait of Dr. Rajib Das, consultant neurologist"
                    width="500"
                    height="500"
                    class="w-full h-full object-cover object-top"
                    loading="eager"
                    fetchpriority="high"
                  />
                  <div class="absolute bottom-2 inset-x-2 bg-white/90 backdrop-blur-xs py-0.5 rounded-lg text-xs font-bold text-teal-800 border border-slate-200">
                    Consultant Neurologist
                  </div>
                </div>

                <h1 class="text-2xl sm:text-3xl font-black text-slate-900 font-serif">Dr. Rajib Das</h1>
                <p class="text-xs text-teal-800 font-bold mt-0.5">MBBS, MD (Neurology)</p>
                <p class="text-xs text-slate-500">Consultant Neurologist & Neurophysiologist</p>

                <div class="mt-4 pt-4 border-t border-slate-100 space-y-1.5 text-left text-xs">
                  <div class="flex justify-between py-0.5 border-b border-slate-100">
                    <span class="text-slate-500">Board Status:</span>
                    <span class="font-bold text-emerald-700">Board Certified</span>
                  </div>
                  <div class="flex justify-between py-0.5 border-b border-slate-100">
                    <span class="text-slate-500">Clinical Exp:</span>
                    <span class="font-bold text-slate-800">15+ Years Active Practice</span>
                  </div>
                  <div class="flex justify-between py-0.5 border-b border-slate-100">
                    <span class="text-slate-500">Specialty:</span>
                    <span class="font-bold text-teal-800">Brain, Spine & Nerves</span>
                  </div>
                  <div class="flex justify-between py-0.5">
                    <span class="text-slate-500">OPD Timings:</span>
                    <span class="font-bold text-teal-800">Mon - Sat (9 AM - 7 PM)</span>
                  </div>
                </div>

                <div class="mt-4 flex flex-col gap-2">
                  <button
                    data-open-modal="booking"
                    class="w-full py-2.5 rounded-xl bg-teal-700 hover:bg-teal-800 text-white font-bold text-sm shadow-xs transition cursor-pointer flex items-center justify-center gap-1.5"
                  >
                    <CalendarIcon class="w-3.5 h-3.5" />
                    <span>Schedule Consultation</span>
                  </button>
                  <a
                    href={whatsapp}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-full py-2 rounded-xl bg-[#25D366] hover:bg-[#1ebe5d] text-white font-bold text-sm text-center flex items-center justify-center gap-1.5 shadow-xs"
                  >
                    <span class="w-4 h-4 rounded-full bg-white/20 flex items-center justify-center text-white shrink-0" aria-hidden="true">
                      <WhatsAppIcon class="w-2.5 h-2.5" />
                    </span>
                    <span>Quick WhatsApp Connect</span>
                  </a>
                </div>

              </div>
            </div>
          </div>

          <div class="lg:col-span-7 space-y-5 reveal">
            <span class="text-xs font-bold uppercase tracking-wider text-teal-800 bg-teal-50 px-3 py-1 rounded-full border border-teal-200">
              Physician Biography
            </span>
            <h2 class="text-2xl sm:text-3xl font-black text-slate-900 leading-snug font-serif">
              A Lifetime Dedication to Precision Neuro-Diagnostics and Human Compassion
            </h2>

            <p class="text-slate-600 leading-relaxed text-sm">
              <strong>Dr. Rajib Das, MBBS, MD (Neurology)</strong> is an accomplished Senior Neurologist known for his analytical diagnostic approach and patient-centered communication with individuals facing complex neurological conditions.
            </p>

            <p class="text-slate-600 leading-relaxed text-sm">
              With more than 15 years in active clinical neurology practice, Dr. Das has successfully treated thousands of patients dealing with acute stroke recovery, refractory migraine syndromes, intractable epilepsy, Parkinson's disease, and excruciating peripheral nerve disorders.
            </p>

            <div class="p-5 rounded-2xl bg-teal-50/70 border border-teal-100 space-y-1.5">
              <h3 class="text-xs font-bold text-slate-900 flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-teal-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span>Clinical Approach</span>
              </h3>
              <p class="text-sm text-slate-700 leading-relaxed italic">
                "In neurology, an illness rarely affects an isolated organ — it impacts an individual's independence, speech, mobility, and identity. Every patient deserves time, rigorous diagnostic inquiry, and complete reassurance on their treatment path."
              </p>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3.5 pt-3 border-t border-slate-200">
              {milestones.map((m) => (
                <div class="bg-white p-3 rounded-2xl border border-slate-200 text-center shadow-xs">
                  <div class="text-xl font-black text-teal-800 font-serif">{m.count}</div>
                  <div class="text-xs font-semibold text-slate-600 mt-0.5">{m.label}</div>
                </div>
              ))}
            </div>

          </div>

        </div>

      </div>
    </section>

    <!-- Clinic Facilities Gallery -->
    <section class="py-14 bg-white border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-8 reveal">
          <span class="text-xs font-bold uppercase tracking-wider text-teal-800 bg-teal-50 px-3 py-1 rounded-full border border-teal-200">
            Clinic Environment
          </span>
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 mt-1.5 font-serif">Patient-First Modern Facilities</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-xs aspect-4/3 relative group reveal">
            <img
              src="https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?auto=format&fit=crop&w=600&q=80"
              alt="Doctor consultation suite"
              width="600"
              height="450"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/70 via-transparent to-transparent flex items-end p-3.5" aria-hidden="true">
              <span class="text-white text-xs font-bold font-serif">Doctor Consultation Suite</span>
            </div>
          </div>

          <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-xs aspect-4/3 relative group reveal" style="transition-delay: 80ms">
            <img
              src="https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&w=600&q=80"
              alt="Digital EEG electrophysiology lab"
              width="600"
              height="450"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/70 via-transparent to-transparent flex items-end p-3.5" aria-hidden="true">
              <span class="text-white text-xs font-bold font-serif">Digital EEG &amp; EMG Electrophysiology Suite</span>
            </div>
          </div>

          <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-xs aspect-4/3 relative group reveal" style="transition-delay: 160ms">
            <img
              src="https://images.unsplash.com/photo-1584515979956-d9f6e5d09982?auto=format&fit=crop&w=600&q=80"
              alt="Neuro-rehabilitation recovery area"
              width="600"
              height="450"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/70 via-transparent to-transparent flex items-end p-3.5" aria-hidden="true">
              <span class="text-white text-xs font-bold font-serif">Neuro-Rehabilitation &amp; Recovery Bay</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Education & Credentials -->
    <section class="py-16 bg-slate-50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-2xl mx-auto mb-12 reveal">
          <span class="text-xs font-bold uppercase tracking-wider text-teal-800 bg-teal-50 px-3 py-1 rounded-full border border-teal-200">Academic Pedigree</span>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 mt-2 font-serif">Education, Fellowships &amp; Accreditations</h2>
          <p class="text-slate-600 text-sm mt-1">Formal medical qualifications and specialized clinical training.</p>
        </div>

        <ol class="space-y-4 list-none">
          {credentials.map((item, idx) => (
            <li class="bg-white rounded-2xl p-5 border border-slate-200 shadow-xs flex flex-col sm:flex-row sm:items-start justify-between gap-3 hover:border-teal-300 transition reveal" style={`transition-delay: ${idx * 60}ms`}>
              <div class="flex items-start gap-3.5">
                <div class="w-8 h-8 rounded-lg bg-teal-50 text-teal-800 flex items-center justify-center shrink-0 font-black text-xs" aria-hidden="true">
                  0{idx + 1}
                </div>
                <div>
                  <h3 class="text-base font-bold text-slate-900 font-serif">{item.degree}</h3>
                  <p class="text-xs font-semibold text-teal-800">{item.institution}</p>
                  <p class="text-xs text-slate-600 mt-1 leading-relaxed">{item.desc}</p>
                </div>
              </div>
              <span class="shrink-0 self-start text-xs font-bold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700">
                {item.year}
              </span>
            </li>
          ))}
        </ol>

      </div>
    </section>

    <!-- Professional Memberships -->
    <section class="py-14 bg-white border-t border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center mb-10 reveal">
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 font-serif">Professional Memberships</h2>
          <p class="text-slate-600 text-sm mt-1">Active participant in medical councils and international clinical bodies.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 text-center reveal">
            <div class="w-10 h-10 rounded-xl bg-teal-50 text-teal-800 flex items-center justify-center mx-auto mb-2.5 font-black text-xs" aria-hidden="true">NSI</div>
            <h3 class="font-bold text-slate-900 text-xs font-serif">Neurological Society</h3>
            <p class="text-xs text-slate-600 mt-0.5">Life Member &amp; Contributor</p>
          </div>
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 text-center reveal" style="transition-delay: 60ms">
            <div class="w-10 h-10 rounded-xl bg-teal-50 text-teal-800 flex items-center justify-center mx-auto mb-2.5 font-black text-xs" aria-hidden="true">AAN</div>
            <h3 class="font-bold text-slate-900 text-xs font-serif">American Academy of Neurology</h3>
            <p class="text-xs text-slate-600 mt-0.5">International Member</p>
          </div>
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 text-center reveal" style="transition-delay: 120ms">
            <div class="w-10 h-10 rounded-xl bg-teal-50 text-teal-800 flex items-center justify-center mx-auto mb-2.5 font-black text-xs" aria-hidden="true">IES</div>
            <h3 class="font-bold text-slate-900 text-xs font-serif">Epilepsy Society</h3>
            <p class="text-xs text-slate-600 mt-0.5">Clinical Researcher</p>
          </div>
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 text-center reveal" style="transition-delay: 180ms">
            <div class="w-10 h-10 rounded-xl bg-teal-50 text-teal-800 flex items-center justify-center mx-auto mb-2.5 font-black text-xs" aria-hidden="true">WSO</div>
            <h3 class="font-bold text-slate-900 text-xs font-serif">World Stroke Organization</h3>
            <p class="text-xs text-slate-600 mt-0.5">Certified Stroke Protocol Member</p>
          </div>
        </div>
      </div>
    </section>

    <ReviewsSection
      headline="Verified Patient Experiences"
      subheadline="Patients share their recovery journeys with Dr. Rajib Das across complex neurological conditions."
    />

    <!-- Consultation Action -->
    <section class="py-14 bg-slate-900 text-white text-center">
      <div class="max-w-3xl mx-auto px-4 reveal">
        <h2 class="text-xl sm:text-2xl font-black font-serif">Schedule an In-Depth Neurological Evaluation</h2>
        <p class="text-sm text-slate-300 mt-1.5">Take the first step toward accurate diagnosis and targeted relief.</p>
        
        <div class="mt-5 flex flex-wrap justify-center gap-3">
          <button
            data-open-modal="booking"
            class="px-6 py-2.5 rounded-xl bg-teal-600 hover:bg-teal-500 text-white font-bold text-sm shadow-xs cursor-pointer"
          >
            Request Appointment Now
          </button>
          <a
            href={`tel:${phone}`}
            class="px-5 py-2.5 rounded-xl bg-slate-800 text-slate-200 font-bold text-sm hover:bg-slate-700 border border-slate-700 flex items-center gap-1.5"
          >
            <span class="w-3.5 h-3.5 rounded-full bg-slate-700 flex items-center justify-center text-teal-400" aria-hidden="true">
              <PhoneIcon class="w-2.5 h-2.5" />
            </span>
            <span>Call {phone}</span>
          </a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
  <MobileActionBar />
  <AppointmentModal />
</Layout>


