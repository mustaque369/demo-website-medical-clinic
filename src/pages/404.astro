---
import { ANALYTICS } from '../constants/analytics';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
---

<Layout
  plausibleDomain={ANALYTICS.plausibleDomain}
  ga4Id={ANALYTICS.ga4MeasurementId}
  enableConsentBanner={ANALYTICS.enableConsentBanner}
  title="Page Not Found (404) | Dr. Rajib Das Neurology Clinic"
  description="The requested page could not be found. Return to Dr. Rajib Das Neurology Clinic home or book a consultation."
  currentPage="/404"
>
  <Navbar currentPage="/404" />

  <main id="main-content" class="min-h-[60vh] flex items-center justify-center py-20 bg-slate-50">
    <div class="max-w-md mx-auto px-4 text-center">
      <span class="inline-block text-xs font-bold uppercase tracking-wider text-teal-800 bg-teal-50 px-3 py-1 rounded-full border border-teal-200 mb-3">
        Error 404
      </span>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 font-serif mb-3">
        Page Not Found
      </h1>
      <p class="text-sm text-slate-600 leading-relaxed mb-6">
        The page you are looking for might have been moved, renamed, or is temporarily unavailable.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-2.5">
        <a
          href="/"
          class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-teal-700 hover:bg-teal-800 text-white font-bold text-sm shadow-xs transition"
        >
          Return to Home
        </a>
        <a
          href="/contact"
          class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-white hover:bg-slate-50 text-slate-700 font-bold text-sm border border-slate-300 transition"
        >
          Contact Clinic
        </a>
      </div>
    </div>
  </main>

  <Footer />
  <MobileActionBar />
</Layout>