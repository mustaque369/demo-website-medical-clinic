---
import { ANALYTICS } from '../constants/analytics';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import AppointmentModal from '../components/AppointmentModal.astro';

const base = import.meta.env.BASE_URL;
---

<Layout
  plausibleDomain={ANALYTICS.plausibleDomain}
  ga4Id={ANALYTICS.ga4MeasurementId}
  enableConsentBanner={ANALYTICS.enableConsentBanner}
  title="Page Not Found (404) | Dr. Kanika Neurology Clinic"
  description="The requested page could not be found. Return to Dr. Kanika Neurology Clinic home or book a consultation."
  currentPage="/404"
  noindex
>
  <Navbar currentPage="/404" />

  <main id="main-content" class="min-h-[60vh] flex items-center justify-center section bg-slate-50">
    <div class="container-narrow text-center">
      <span class="inline-block text-label px-3 py-1 rounded-sm border border-teal-200 mb-3">
        Error 404
      </span>
      <h1 class="text-h1 text-slate-900 mb-3">
        Page Not Found
      </h1>
      <p class="text-body text-slate-600 mb-6">
        The page you are looking for might have been moved, renamed, or is temporarily unavailable.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-2.5">
        <a href={base} class="btn btn-teal w-full sm:w-auto">
          Return to Home
        </a>
        <a href={`${base}contact`} class="btn btn-outline w-full sm:w-auto">
          Contact Clinic
        </a>
      </div>
    </div>
  </main>

  <Footer />
  <MobileActionBar />
  <!-- Without this, the "Book Consultation" buttons in the header do nothing. -->
  <AppointmentModal />
</Layout>

