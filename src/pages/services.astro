---
import { ANALYTICS } from '../constants/analytics';
import { CLINIC } from '../constants';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import AppointmentModal from '../components/AppointmentModal.astro';
import PhoneIcon from '../components/icons/PhoneIcon.astro';
import WhatsAppIcon from '../components/icons/WhatsAppIcon.astro';
import CalendarIcon from '../components/icons/CalendarIcon.astro';

const phoneHref = CLINIC.phoneHref;
const whatsapp = CLINIC.whatsappUrl;

const diagnosticTests = [
  {
    name: "Digital Electroencephalography (EEG)",
    duration: "45 - 60 mins",
    desc: "Measures electrical activity in the brain. Essential for detecting epilepsy types, seizure foci, unexplained unconsciousness, sleep disorders, and encephalopathy.",
    prep: "Wash hair cleanly prior to test without oils, styling gels, or sprays.",
    image: "https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&w=600&q=80"
  },
  {
    name: "Electromyography & Nerve Conduction (EMG / NCV)",
    duration: "40 - 50 mins",
    desc: "Evaluates the health of peripheral nerves and muscles. Accurately diagnoses carpal tunnel syndrome, radiculopathy, diabetic peripheral neuropathy, and motor neuron disease.",
    prep: "Wear loose comfortable clothing; avoid oily lotions or creams on hands/legs.",
    image: "https://images.unsplash.com/photo-1530497610245-94d3c16cda28?auto=format&fit=crop&w=600&q=80"
  },
  {
    name: "Visual & Somatosensory Evoked Potentials (VEP / SSEP)",
    duration: "30 - 45 mins",
    desc: "Tracks nerve electrical conduction along the sensory and visual pathways to the brain, critical in multiple sclerosis (MS) and optic neuritis evaluations.",
    prep: "Bring prescription eyeglasses or contact lens details if applicable.",
    image: "https://images.unsplash.com/photo-1516549655169-df83a0774514?auto=format&fit=crop&w=600&q=80"
  },
  {
    name: "Neurocognitive & Memory Battery Screening",
    duration: "60 mins",
    desc: "Standardized clinical cognitive evaluation assessing memory retention, executive processing speed, early mild cognitive impairment (MCI), and Alzheimer's disease stages.",
    prep: "Bring an accompanied family member or caregiver to assist with medical history.",
    image: "https://images.unsplash.com/photo-1576765608535-5f04d1e3f289?auto=format&fit=crop&w=600&q=80"
  }
];

const clinicalConditions = [
  {
    category: "Cerebrovascular & Stroke Care",
    symptoms: "Sudden facial drooping, arm numbness, slurred speech, acute dizziness.",
    treatments: "Hyper-acute stroke protocol, antithrombotic optimization, secondary prevention, and structured rehabilitation.",
    image: "https://images.unsplash.com/photo-1559757175-5700dde675bc?auto=format&fit=crop&w=500&q=80"
  },
  {
    category: "Severe Migraines & Chronic Headaches",
    symptoms: "Throbbing one-sided pain, light/sound sensitivity, visual auras, tension bands.",
    treatments: "Prophylactic therapy, specialized Botox for chronic migraine, occipital nerve blocks, and trigger analysis.",
    image: "https://images.unsplash.com/photo-1505751172876-fa1923c5c528?auto=format&fit=crop&w=500&q=80"
  },
  {
    category: "Epilepsy & Seizure Disorders",
    symptoms: "Generalized convulsions, staring spells, sudden involuntary limb jerks, blackout episodes.",
    treatments: "Digital Video EEG classification, personalized antiepileptic drug optimization, and lifestyle advice.",
    image: "https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&w=500&q=80"
  },
  {
    category: "Movement Disorders & Parkinson's",
    symptoms: "Resting hand tremors, slowed body movements (bradykinesia), rigid posture, gait freezing.",
    treatments: "Dopaminergic medication titration, balance rehabilitation, and deep brain stimulation (DBS) candidacy screening.",
    image: "https://images.unsplash.com/photo-1584515979956-d9f6e5d09982?auto=format&fit=crop&w=500&q=80"
  },
  {
    category: "Peripheral Neuropathy & Sciatica",
    symptoms: "Burning feet sensation, pins and needles, sciatic leg pain, loss of vibration sensation.",
    treatments: "Targeted neuropathic medication, diabetic glycemic nerve support, vitamin deficiency therapy, ergonomic stabilization.",
    image: "https://images.unsplash.com/photo-1530497610245-94d3c16cda28?auto=format&fit=crop&w=500&q=80"
  },
  {
    category: "Memory Loss, Dementia & Alzheimer's",
    symptoms: "Forgetting recent events, getting lost in familiar locations, cognitive disorientation.",
    treatments: "Cholinesterase inhibitors, NMDA receptor antagonists, cognitive stimulation therapy, and caregiver guidance.",
    image: "https://images.unsplash.com/photo-1576765608535-5f04d1e3f289?auto=format&fit=crop&w=500&q=80"
  }
];

const faqs = [
  {
    q: "What documents should I bring for my first consultation with Dr. Rajib Das?",
    a: "Please bring all prior medical records, recent brain or spine scans (MRI / CT films and reports), list of current medications with exact dosages, recent blood test results, and any previous EEG/EMG reports."
  },
  {
    q: "Do I need to do an MRI before visiting the clinic?",
    a: "Not necessarily. Dr. Rajib Das conducts a comprehensive clinical neurological exam first. If imaging is indicated, he will order the exact MRI sequence or CT scan required, avoiding unnecessary expenses."
  },
  {
    q: "How can I book an urgent appointment for acute stroke or severe flare-ups?",
    a: "For acute emergencies (sudden speech loss, facial weakness, severe seizure), visit an emergency hospital immediately or call our clinic emergency line directly at +91 90000 00000."
  },
  {
    q: "Does the clinic offer EEG and EMG/NCV testing on-site?",
    a: "Yes, our clinic center is equipped with modern digital electrophysiology suites allowing same-day or scheduled EEG and EMG/NCV studies conducted under Dr. Das's direct supervision."
  }
];
---

<Layout
  title="Neurological Services & Diagnostic Procedures | Dr. Rajib Das"
  description="Explore neurology services by Dr. Rajib Das: Stroke management, Chronic Migraine therapy, Epilepsy, Parkinson's, EEG, EMG/NCV diagnostics."
  currentPage="/services"
  plausibleDomain={ANALYTICS.plausibleDomain}
  ga4Id={ANALYTICS.ga4MeasurementId}
  enableConsentBanner={ANALYTICS.enableConsentBanner}
>
  <Navbar currentPage="/services" />

  <main id="main-content">
    <!-- Header Hero: single max-width (fixed former max-w-7xl + max-w-3xl conflict) -->
    <section class="hero-wash section border-b border-slate-200">
      <div class="container-narrow text-center">
        <span class="text-label px-3 py-1 rounded-sm border border-teal-200">
          Clinical Neurological Care
        </span>
        <h1 class="text-h1 text-slate-900 mt-3">
          Specialized Services & Neuro-Diagnostics
        </h1>
        <p class="text-body text-slate-600 mt-2.5">
          From advanced in-house electrophysiology (EEG, EMG) to specialized clinical care for stroke, migraine, and tremors by Dr. Rajib Das, MBBS, MD (Neurology).
        </p>

        <div class="mt-6 flex flex-wrap justify-center gap-2.5">
          <button
            data-open-modal="booking"
            class="btn btn-teal"
          >
            <CalendarIcon class="w-3.5 h-3.5" />
            <span>Schedule Consultation</span>
          </button>
          <a
            href={whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp"
          >
            <span class="text-white shrink-0" aria-hidden="true">
              <WhatsAppIcon class="w-2.5 h-2.5" />
            </span>
            <span>Inquire via WhatsApp</span>
          </a>
        </div>
      </div>
    </section>

        <!-- Advanced Diagnostics — Reference 2 Style -->
    <section class="section bg-[#f8fbff] border-y border-slate-200" id="diagnostics">
      <div class="container-main">
        
        <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16 reveal">
          <span class="text-xs font-bold tracking-widest text-[#0c4a8a] uppercase block mb-3">ACCURATE DIAGNOSIS. BETTER TREATMENT.</span>
          <h2 class="text-h2 text-charcoal font-medium mb-4">Diagnostic Procedures</h2>
          <p class="text-body text-graphite">We use modern, non-invasive diagnostic tools to accurately assess your condition and plan the right treatment. Each test is explained clearly, so you know what to expect.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6">
          {diagnosticTests.map((test, i) => (
            <div class="bg-white rounded-2xl border border-slate-200 p-6 flex flex-col hover:shadow-[0_8px_30px_-4px_rgba(12,74,138,0.12)] hover:border-teal-200 transition-all duration-300 reveal" style={`transition-delay: ${i * 60}ms`}>
              <div class="w-12 h-12 rounded-full bg-blue-50 text-[#0c4a8a] flex items-center justify-center mb-4 shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
              </div>
              <h3 class="text-[1.05rem] font-bold text-slate-900 mb-2 leading-tight">{test.name}</h3>
              <p class="text-sm text-slate-600 mb-6 flex-1 leading-relaxed">{test.desc}</p>
              
              <div class="mt-auto">
                <span class="inline-flex items-center text-[0.8rem] font-semibold text-[#0c4a8a] bg-blue-50 px-3 py-1.5 rounded-full hover:bg-blue-100 transition-colors cursor-help" title={`Prep: ${test.prep} | Duration: ${test.duration}`}>
                  What to Expect &rarr;
                </span>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-12 text-center reveal">
          <button data-open-modal="booking" class="btn bg-[#0c4a8a] text-white hover:bg-blue-900 px-8 py-3.5 rounded-full text-[15px] font-semibold transition-all inline-flex items-center justify-center shadow-md">
            Explore All Diagnostic Procedures & Prep &rarr;
          </button>
        </div>

      </div>
    </section>

    <!-- Conditions We Treat -->
    <section class="section bg-white border-t border-slate-200">
      <div class="container-main">
        
        <div class="text-center max-w-3xl mx-auto mb-14 md:mb-20 reveal">
          <span class="text-label px-3 py-1 rounded-sm border border-teal-200">
            Clinical Management
          </span>
          <h2 class="text-h2 text-slate-900 mt-2">Conditions We Treat</h2>
          <p class="text-body-sm text-slate-600 mt-1">Comprehensive protocols customized to individual patient profiles.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          {clinicalConditions.map((cond, i) => (
            <div class="bg-slate-50 rounded-2xl overflow-hidden border border-slate-200 hover:border-teal-300 transition flex flex-col justify-between medical-card-enhanced reveal" style={`transition-delay: ${i * 50}ms`}>
              <div>
                <div class="img-frame h-32 w-full">
                  <img
                    src={cond.image}
                    alt={cond.category}
                    width="500"
                    height="300"
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                  <div class="img-scrim absolute inset-0" aria-hidden="true"></div>
                  <h3 class="absolute bottom-2.5 left-3 right-3 text-h5 text-white leading-snug">
                    {cond.category}
                  </h3>
                </div>

                <div class="p-4 space-y-2.5 text-body-sm">
                  <div>
                    <span class="font-semibold text-slate-800 block mb-0.5">Key Symptoms:</span>
                    <span class="text-slate-600">{cond.symptoms}</span>
                  </div>

                  <div>
                    <span class="font-semibold text-slate-800 block mb-0.5">Clinical Care:</span>
                    <span class="text-slate-600">{cond.treatments}</span>
                  </div>
                </div>
              </div>

              <div class="p-4 pt-0">
                <button
                  data-open-modal="booking"
                  class="btn btn-teal w-full py-2 rounded-xl text-caption font-semibold text-center cursor-pointer"
                >
                  Book Consultation for this condition ?
                </button>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- FAQ Accordion -->
    <section id="faq" class="section bg-slate-900 text-white relative">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center mb-14 reveal">
          <span class="text-label-light text-teal-300 px-3 py-1 rounded-sm border border-teal-700">
            Answers for Patients
          </span>
          <h2 class="text-h2 text-white mt-2">Frequently Asked Questions</h2>
          <p class="text-slate-400 text-sm mt-1">Everything you need to know about your consultation with Dr. Rajib Das.</p>
        </div>

        <div class="space-y-3">
          {faqs.map((faq) => (
            <details class="group bg-slate-800 rounded-2xl border border-slate-700 p-4 transition open:bg-slate-800/90">
              <summary class="flex justify-between items-center text-body font-semibold text-white cursor-pointer gap-3">
                <span>{faq.q}</span>
                <span class="text-teal-400 group-open:rotate-180 transition-transform shrink-0" aria-hidden="true">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                  </svg>
                </span>
              </summary>
              <p class="text-body-sm text-slate-300 mt-3 pt-3 border-t border-slate-700">
                {faq.a}
              </p>
            </details>
          ))}
        </div>

      </div>
    </section>

    <!-- Consultation Strip -->
    <section class="section-sm bg-teal-800 text-white text-center">
      <div class="container-narrow">
        <h2 class="text-h3">Need Clear Neurological Guidance?</h2>
        <p class="text-body text-teal-100 mt-1.5">Our clinic care coordinator is ready to assist you and reserve your consultation slot.</p>
        
        <div class="mt-5 flex flex-wrap justify-center gap-2.5">
          <button
            data-open-modal="booking"
            class="btn btn-charcoal px-6 py-2.5 rounded-xl text-btn font-semibold cursor-pointer"
          >
            Book Appointment Slot
          </button>
          <a
            href={phoneHref}
            class="btn btn-outline px-5 py-2.5 rounded-xl text-btn font-semibold flex items-center gap-1.5"
          >
            <span class="text-white" aria-hidden="true">
              <PhoneIcon class="w-2.5 h-2.5" />
            </span>
            <span>Call {CLINIC.phone}</span>
          </a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
  <MobileActionBar />
  <AppointmentModal />
</Layout>

