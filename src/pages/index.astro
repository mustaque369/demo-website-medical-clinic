---
import { ANALYTICS } from '../constants/analytics';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import AppointmentModal from '../components/AppointmentModal.astro';
import PhoneIcon from '../components/icons/PhoneIcon.astro';
import WhatsAppIcon from '../components/icons/WhatsAppIcon.astro';
import CalendarIcon from '../components/icons/CalendarIcon.astro';

const phone = "+91 98765 43210";
const whatsapp = "https://wa.me/919876543210?text=" + encodeURIComponent("Hello Dr. Rajib Das Clinic, I would like to schedule a neurology consultation.");

const services = [
  {
    title: "Stroke & Cerebrovascular Care",
    desc: "Rapid response stroke protocols, ischemic and hemorrhagic management, prevention, and neuro-rehabilitation.",
    icon: "M13 10V3L4 14h7v7l9-11h-7z",
    image: "https://images.unsplash.com/photo-1551076805-e1869033e561?auto=format&fit=crop&w=800&q=85",
    href: "/services"
  },
  {
    title: "Chronic Migraine & Headache",
    desc: "Targeted diagnosis of cluster, tension, and persistent migraines with modern prophylactic protocols and relief plans.",
    icon: "M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z",
    image: "https://images.unsplash.com/photo-1579684453423-f84349ef60b0?auto=format&fit=crop&w=800&q=85",
    href: "/services"
  },
  {
    title: "Epilepsy & Seizure Disorders",
    desc: "Digital Video EEG monitoring, seizure classification, and medication management for pediatric and adult patients.",
    icon: "M13 7h8m0 0v8m0-8l-8 8-4-4-6 6",
    image: "https://images.unsplash.com/photo-1631815587646-b85a1bb027e1?auto=format&fit=crop&w=800&q=85",
    href: "/services"
  },
  {
    title: "Parkinson's & Movement Care",
    desc: "Advanced therapeutic interventions for hand tremors, rigid posture, Parkinson's disease, and balance disorders.",
    icon: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
    image: "https://images.unsplash.com/photo-1583324113626-70df0f4deaab?auto=format&fit=crop&w=800&q=85",
    href: "/services"
  },
  {
    title: "Neuropathy & Sciatica Relief",
    desc: "Electromyography (EMG) and Nerve Conduction Velocity (NCV) testing for diabetic nerve pain and spinal radiculopathy.",
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
    image: "https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?auto=format&fit=crop&w=800&q=85",
    href: "/services"
  },
  {
    title: "Memory Loss & Dementia",
    desc: "Detailed cognitive screenings for early Alzheimer's, memory deficits, and supportive care plans for families.",
    icon: "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z",
    image: "https://images.unsplash.com/photo-1666214280557-f1b5022eb634?auto=format&fit=crop&w=800&q=85",
    href: "/services"
  }
];

// Stat values are rendered as final text in HTML (so they're correct without JS);
// the script animates from 0 only when the band scrolls into view.
const stats = [
  { target: 15, suffix: '+', display: '15', label: 'Years Clinical Practice', sub: 'Specialized neuro care', icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z' },
  { target: 12500, suffix: '+', display: '12,500', label: 'Patients Treated', sub: 'Comprehensive consultations', icon: "M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 10-4-4 4 4 0 004 4zm6-4a4 4 0 11-4-4" },
  { target: 3800, suffix: '+', display: '3,800', label: 'EEG & EMG Diagnostics', sub: 'High precision neurophysiology', icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
  { target: 99, suffix: '%', display: '99', label: 'Patient Satisfaction', sub: 'Based on 248+ reviews', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' },
];
---

<Layout
  plausibleDomain={ANALYTICS.plausibleDomain}
  ga4Id={ANALYTICS.ga4MeasurementId}
  enableConsentBanner={ANALYTICS.enableConsentBanner}
  title="Dr. Rajib Das, MBBS, MD (Neurology) | Neurologist & Brain Specialist"
  description="Consult with Dr. Rajib Das, leading Neurologist specializing in Stroke, Migraine, Epilepsy, Parkinson's, Nerve Pain, EEG & EMG diagnostics."
  currentPage="/"
>
  <Navbar currentPage="/" />

  <main id="main-content">
    <!-- 1. Hero — Light split layout with doctor photo -->
    <section class="hero-clinical relative overflow-hidden" aria-label="Welcome">
      <!-- Subtle gradient background -->
      <div class="absolute inset-0 bg-gradient-to-br from-white via-white to-blue-50/80" aria-hidden="true"></div>
      <!-- Faint brain watermark on right -->
      <div class="absolute top-1/2 right-0 -translate-y-1/2 translate-x-1/4 w-[600px] h-[600px] opacity-[0.04]" aria-hidden="true">
        <svg viewBox="0 0 200 200" fill="currentColor" class="w-full h-full text-blue-900">
          <path d="M100 10C75 10 55 25 50 45C35 48 20 65 20 85C20 100 28 112 40 118C37 128 40 142 55 150C53 158 58 172 72 177C77 192 87 200 100 200C113 200 123 192 128 177C142 172 147 158 145 150C160 142 163 128 160 118C172 112 180 100 180 85C180 65 165 48 150 45C145 25 125 10 100 10Z"/>
        </svg>
      </div>

      <div class="relative z-10 container-main flex flex-col lg:flex-row items-center gap-8 lg:gap-12 py-16 md:py-20 lg:py-24">
        
        <!-- Left: Text Content -->
        <div class="flex-1 space-y-6 text-center lg:text-left">
          <!-- Eyebrow -->
          <div class="inline-flex items-center gap-2.5">
            <span class="text-teal-600 font-bold text-xs">✦</span>
            <span class="text-label text-teal-700 tracking-[0.18em]">Senior Consultant Neurologist</span>
          </div>

          <h1 class="text-display text-charcoal max-w-2xl leading-[1.08] font-medium">
            Advanced Neurological Care,<br>
            <span class="font-serif italic font-light text-[1.02em]">Guided by Precision &amp; Understanding</span>
          </h1>

          <p class="text-lead text-graphite max-w-[52ch] mx-auto lg:mx-0">
            Expert diagnosis, advanced treatment and compassionate care for a healthier brain and a better tomorrow.
          </p>

          <!-- CTA Buttons -->
          <div class="flex flex-col sm:flex-row items-center lg:items-start gap-4 pt-2">
            <button
              data-open-modal="booking"
              class="nav-cta-btn px-8 py-3.5 text-base"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              Book Consultation
              <span aria-hidden="true">→</span>
            </button>
            <a
              href={`${import.meta.env.BASE_URL}#services`}
              class="inline-flex items-center gap-2.5 px-6 py-3.5 rounded-full border border-slate-300 text-charcoal font-semibold text-[0.9375rem] hover:border-teal-600 hover:text-teal-700 transition-colors"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
              </svg>
              View Services
            </a>
          </div>

          <!-- Stats Badges -->
          <div class="flex flex-wrap items-center justify-center lg:justify-start gap-6 pt-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-teal-50 flex items-center justify-center text-teal-700">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <p class="text-charcoal font-bold text-sm">15+ Years</p>
                <p class="text-mist text-xs">Clinical Experience</p>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-teal-50 flex items-center justify-center text-teal-700">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              </div>
              <div>
                <p class="text-charcoal font-bold text-sm">In-house EEG & EMG</p>
                <p class="text-mist text-xs">Diagnostics</p>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-teal-50 flex items-center justify-center text-teal-700">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
              </div>
              <div>
                <p class="text-charcoal font-bold text-sm">Trusted by</p>
                <p class="text-mist text-xs">Thousands of Patients</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Doctor Photo + Profile Card -->
        <div class="w-full max-w-md lg:max-w-lg shrink-0 relative reveal" style="transition-delay: 150ms;">
          <!-- Doctor Photo -->
          <div class="relative">
            <img 
              src="https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?auto=format&fit=crop&w=800&q=85" 
              alt="Dr. Rajib Das — Senior Consultant Neurologist" 
              class="w-full rounded-2xl object-cover shadow-lg"
              width="800"
              height="900"
              loading="eager"
            />
            <!-- Small blue circle accent -->
            <div class="absolute top-4 left-1/2 -translate-x-1/2 w-8 h-8 rounded-full border-2 border-teal-400 bg-white flex items-center justify-center" aria-hidden="true">
              <div class="w-2 h-2 bg-teal-500 rounded-full"></div>
            </div>
          </div>

          <!-- Floating Profile Card -->
          <div class="absolute bottom-4 right-4 left-4 sm:left-auto sm:right-4 sm:bottom-6 bg-white rounded-xl shadow-xl border border-slate-200 p-4 sm:p-5 sm:w-72">
            <div class="flex items-start justify-between">
              <div>
                <h2 class="text-charcoal font-bold text-base">Dr. Rajib Das</h2>
                <p class="text-mist text-xs mt-0.5">MBBS, MD (Neurology)</p>
                <p class="text-mist text-xs">Senior Consultant Neurologist</p>
              </div>
              <a href={`${import.meta.env.BASE_URL}about`} class="w-8 h-8 rounded-full bg-teal-700 text-white flex items-center justify-center shrink-0 hover:bg-teal-800 transition-colors" aria-label="View doctor profile">
                <span aria-hidden="true">→</span>
              </a>
            </div>
            <!-- Signature -->
            <div class="mt-3 pt-3 border-t border-slate-100">
              <p class="font-serif italic text-sm text-slate-400">Dr. Rajib Das</p>
            </div>
          </div>
        </div>

      </div>
    </section>
    <!-- 2. Full-horizon stats band (icons + counters that render final values without JS) -->
    <section class="bg-teal-50 border-y border-teal-100 py-10 md:py-12" aria-label="Practice statistics">
      <div class="container-main">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
          {stats.map((stat) => (
            <div class="p-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={stat.icon}/>
              </svg>
              <div class="text-stat text-charcoal flex items-center justify-center">
                <span class="counter-number" data-target={stat.target}>{stat.display}</span>
                <span aria-hidden="true">{stat.suffix}</span>
              </div>
              <div class="text-label text-teal-700 mt-1">
                {stat.label}
              </div>
              <p class="text-xs text-mist hidden sm:block mt-0.5">{stat.sub}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. Services — Card Grid -->
    <section id="services" class="section bg-white" aria-label="Neurological services">
      <div class="container-main">

        <!-- Section header -->
        <div class="max-w-2xl mb-12 md:mb-16 reveal">
          <div class="inline-flex items-center gap-2 mb-4">
            <span class="text-teal-600 font-bold text-xs">→</span>
            <span class="text-label text-teal-700 tracking-[0.18em]">Our Services</span>
          </div>
          <h2 class="text-h2 text-charcoal font-medium mb-3">Comprehensive Neurological Care</h2>
          <p class="text-body text-graphite max-w-xl">Expert diagnosis and treatment for a wide range of neurological conditions.</p>
        </div>

        <!-- Service Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          {services.map((item, i) => (
            <div class="group bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-lg hover:border-teal-200 transition-all duration-300 reveal" style={`transition-delay: ${i * 80}ms`}>
              <!-- Card Image -->
              <div class="relative h-48 overflow-hidden">
                <img
                  src={item.image}
                  alt=""
                  role="presentation"
                  width="600"
                  height="400"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </div>
              <!-- Card Content -->
              <div class="p-6">
                <div class="flex items-center gap-3 mb-3">
                  <div class="w-10 h-10 rounded-xl bg-teal-50 flex items-center justify-center text-teal-700 shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={item.icon}/>
                    </svg>
                  </div>
                  <h3 class="text-h5 text-charcoal font-semibold">{item.title}</h3>
                </div>
                <p class="text-body-sm text-graphite mb-4 line-clamp-3">{item.desc}</p>
                <a href={item.href} class="inline-flex items-center gap-1.5 text-sm font-semibold text-teal-700 hover:text-teal-900 transition-colors">
                  Learn More <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          ))}
        </div>

        <!-- Diagnostic CTA Banner -->
        <div class="mt-12 md:mt-16 bg-slate-50 rounded-2xl p-6 md:p-8 flex flex-col md:flex-row items-center justify-between gap-6 reveal border border-slate-200">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-teal-50 flex items-center justify-center text-teal-700 shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            </div>
            <div>
              <p class="text-sm text-graphite">Need a detailed look at our diagnostic tests?</p>
              <p class="text-charcoal font-bold text-lg">Explore All Diagnostic Procedures & Prep with Effects</p>
            </div>
          </div>
          <a href={`${import.meta.env.BASE_URL}services`} class="nav-cta-btn whitespace-nowrap">
            View Diagnostic Procedures <span aria-hidden="true">→</span>
          </a>
        </div>

      </div>
    </section>
    <!-- 3b. Doctor Profile + Our Approach — Reference 3 -->
    <section id="about-doctor" class="section bg-cream" aria-label="Meet Dr. Rajib Das">
      <div class="container-main">

        <!-- Doctor Profile Row -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center mb-16 lg:mb-20">
          <!-- Left: Doctor Photo -->
          <div class="relative max-w-md mx-auto lg:max-w-none reveal">
            <img 
              src="https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?auto=format&fit=crop&w=700&q=85" 
              alt="Dr. Rajib Das — Neurologist" 
              class="w-full rounded-2xl shadow-md object-cover"
              width="700"
              height="850"
              loading="lazy"
            />
            <!-- Signature overlay -->
            <div class="absolute bottom-4 left-4 bg-white/90 backdrop-blur-sm rounded-lg px-4 py-2 shadow-sm" aria-hidden="true">
              <p class="font-serif italic text-sm text-slate-500">Dr. Rajib Das</p>
              <p class="text-xs text-mist">Neurologist</p>
            </div>
          </div>

          <!-- Right: Bio & Credentials -->
          <div class="space-y-6 reveal" style="transition-delay: 100ms;">
            <div class="inline-flex items-center gap-2">
              <span class="text-teal-600 font-bold text-xs">→</span>
              <span class="text-label text-teal-700 tracking-[0.18em]">Meet Your Neurologist</span>
            </div>

            <h2 class="text-display text-charcoal font-medium leading-tight">Dr. Rajib Das</h2>
            <p class="text-lg text-teal-700 font-medium">Consultant Neurologist & Neurophysiologist</p>
            
            <p class="text-body text-graphite max-w-lg">
              With over 15 years of experience in neurology and neurophysiology, Dr. Rajib Das provides compassionate, evidence-based care for a wide range of neurological conditions. His patient-first approach ensures personalized treatment and better outcomes.
            </p>

            <!-- Credential Badges -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
              <div class="flex flex-col items-center text-center p-3 rounded-xl border border-slate-200 bg-white">
                <div class="w-8 h-8 rounded-full bg-teal-50 flex items-center justify-center text-teal-700 mb-2">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                </div>
                <p class="text-charcoal font-bold text-sm">15+ Years</p>
                <p class="text-mist text-xs">Clinical Experience</p>
              </div>
              <div class="flex flex-col items-center text-center p-3 rounded-xl border border-slate-200 bg-white">
                <div class="w-8 h-8 rounded-full bg-teal-50 flex items-center justify-center text-teal-700 mb-2">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342"/></svg>
                </div>
                <p class="text-charcoal font-bold text-sm">MBBS</p>
                <p class="text-mist text-xs">General Medicine</p>
              </div>
              <div class="flex flex-col items-center text-center p-3 rounded-xl border border-slate-200 bg-white">
                <div class="w-8 h-8 rounded-full bg-teal-50 flex items-center justify-center text-teal-700 mb-2">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693L5 16.5m14.8-1.2a9 9 0 10-15.6 0"/></svg>
                </div>
                <p class="text-charcoal font-bold text-sm">MD</p>
                <p class="text-mist text-xs">(Neurology)</p>
              </div>
              <div class="flex flex-col items-center text-center p-3 rounded-xl border border-slate-200 bg-white">
                <div class="w-8 h-8 rounded-full bg-teal-50 flex items-center justify-center text-teal-700 mb-2">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                </div>
                <p class="text-charcoal font-bold text-sm">EEG & EMG</p>
                <p class="text-mist text-xs">Diagnostics</p>
              </div>
            </div>

            <button data-open-modal="booking" class="nav-cta-btn px-8 py-3.5 text-base mt-2">
