---
import { ANALYTICS } from '../constants/analytics';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import AppointmentModal from '../components/AppointmentModal.astro';
import PhoneIcon from '../components/icons/PhoneIcon.astro';
import WhatsAppIcon from '../components/icons/WhatsAppIcon.astro';
import CalendarIcon from '../components/icons/CalendarIcon.astro';

const phone = "+91 98765 43210";
const whatsapp = "https://wa.me/919876543210?text=" + encodeURIComponent("Hello Dr. Rajib Das Clinic, I would like to schedule a neurology consultation.");

const services = [
  {
    title: "Stroke & Cerebrovascular Care",
    desc: "Rapid response stroke protocols, ischemic and hemorrhagic management, prevention, and neuro-rehabilitation.",
    icon: "M13 10V3L4 14h7v7l9-11h-7z",
    image: "https://images.unsplash.com/photo-1559757175-5700dde675bc?auto=format&fit=crop&w=600&q=80",
    href: "/services"
  },
  {
    title: "Chronic Migraine & Headache",
    desc: "Targeted diagnosis of cluster, tension, and persistent migraines with modern prophylactic protocols and relief plans.",
    icon: "M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z",
    image: "https://images.unsplash.com/photo-1505751172876-fa1923c5c528?auto=format&fit=crop&w=600&q=80",
    href: "/services"
  },
  {
    title: "Epilepsy & Seizure Disorders",
    desc: "Digital Video EEG monitoring, seizure classification, and medication management for pediatric and adult patients.",
    icon: "M13 7h8m0 0v8m0-8l-8 8-4-4-6 6",
    image: "https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&w=600&q=80",
    href: "/services"
  },
  {
    title: "Parkinson's & Movement Care",
    desc: "Advanced therapeutic interventions for hand tremors, rigid posture, Parkinson's disease, and balance disorders.",
    icon: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
    image: "https://images.unsplash.com/photo-1584515979956-d9f6e5d09982?auto=format&fit=crop&w=600&q=80",
    href: "/services"
  },
  {
    title: "Neuropathy & Sciatica Relief",
    desc: "Electromyography (EMG) and Nerve Conduction Velocity (NCV) testing for diabetic nerve pain and spinal radiculopathy.",
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
    image: "https://images.unsplash.com/photo-1530497610245-94d3c16cda28?auto=format&fit=crop&w=600&q=80",
    href: "/services"
  },
  {
    title: "Memory Loss & Dementia",
    desc: "Detailed cognitive screenings for early Alzheimer's, memory deficits, and supportive care plans for families.",
    icon: "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z",
    image: "https://images.unsplash.com/photo-1576765608535-5f04d1e3f289?auto=format&fit=crop&w=600&q=80",
    href: "/services"
  }
];

// Stat values are rendered as final text in HTML (so they're correct without JS);
// the script animates from 0 only when the band scrolls into view.
const stats = [
  { target: 15, suffix: '+', display: '15', label: 'Years Clinical Practice', sub: 'Specialized neuro care', icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z' },
  { target: 12500, suffix: '+', display: '12,500', label: 'Patients Treated', sub: 'Comprehensive consultations', icon: "M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 10-4-4 4 4 0 004 4zm6-4a4 4 0 11-4-4" },
  { target: 3800, suffix: '+', display: '3,800', label: 'EEG & EMG Diagnostics', sub: 'High precision neurophysiology', icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
  { target: 99, suffix: '%', display: '99', label: 'Patient Satisfaction', sub: 'Based on 248+ reviews', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' },
];
---

<Layout
  plausibleDomain={ANALYTICS.plausibleDomain}
  ga4Id={ANALYTICS.ga4MeasurementId}
  enableConsentBanner={ANALYTICS.enableConsentBanner}
  title="Dr. Rajib Das, MBBS, MD (Neurology) | Neurologist & Brain Specialist"
  description="Consult with Dr. Rajib Das, leading Neurologist specializing in Stroke, Migraine, Epilepsy, Parkinson's, Nerve Pain, EEG & EMG diagnostics."
  currentPage="/"
>
  <Navbar currentPage="/" />

  <main id="main-content">
    <!-- 1. Hero -->
    <section class="relative bg-gradient-to-b from-teal-50/50 via-white to-slate-50 py-14 sm:py-18 overflow-hidden border-b border-slate-200">
      <div class="absolute inset-0 hero-medical-glow pointer-events-none" aria-hidden="true"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          
          <div class="lg:col-span-7 space-y-5 text-center lg:text-left">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-teal-50 text-teal-800 border border-teal-200">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
              Consultant Neurologist & Clinical Neurophysiologist
            </div>

            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-slate-900 leading-tight font-serif">
              Precision Neurological Care & <span class="text-teal-700">Brain Health</span>
            </h1>

            <p class="text-sm sm:text-base text-slate-600 max-w-2xl leading-relaxed mx-auto lg:mx-0">
              Personalized diagnosis and compassionate clinical management of complex conditions affecting the brain, spine, and nerves by <strong>Dr. Rajib Das, MBBS, MD (Neurology)</strong>.
            </p>

            <!-- CTAs: single solid primary, outlined WhatsApp, ghost call (clear hierarchy) -->
            <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3 pt-1">
              <button
                data-open-modal="booking"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl font-bold text-white bg-teal-700 hover:bg-teal-800 shadow-md shadow-teal-700/20 transition-all hover:-translate-y-0.5 cursor-pointer text-sm"
              >
                <CalendarIcon class="w-4 h-4" />
                <span>Book Appointment</span>
              </button>

              <a
                href={whatsapp}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl font-bold text-teal-800 bg-white border-2 border-teal-700 hover:bg-teal-50 transition-all text-sm"
              >
                <span class="w-5 h-5 rounded-full bg-[#25D366] flex items-center justify-center text-white shrink-0" aria-hidden="true">
                  <WhatsAppIcon class="w-3 h-3" />
                </span>
                <span>Chat on WhatsApp</span>
              </a>

              <a
                href={`tel:${phone}`}
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl font-bold text-slate-600 hover:text-teal-800 hover:bg-white border border-slate-300 hover:border-teal-300 transition text-sm"
              >
                <PhoneIcon class="w-4 h-4 text-teal-700" />
                <span>Call Clinic</span>
              </a>
            </div>

            <!-- Trust badges -->
            <div class="pt-3 flex flex-wrap items-center justify-center lg:justify-start gap-4 text-xs font-semibold text-slate-600">
              <span class="flex items-center gap-1.5">
                <svg class="w-4 h-4 text-teal-700" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                Board Certified Neurologist
              </span>
              <span class="flex items-center gap-1.5">
                <svg class="w-4 h-4 text-teal-700" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                On-Site Digital EEG / EMG
              </span>
              <span class="flex items-center gap-1.5">
                <svg class="w-4 h-4 text-teal-700" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                Zero Long Waiting Times
              </span>
            </div>

          </div>

          <!-- Doctor profile card -->
          <div class="lg:col-span-5">
            <div class="relative max-w-sm mx-auto">
              <div class="bg-white rounded-3xl p-5 border border-slate-200 shadow-lg">
                
                <div class="relative rounded-2xl overflow-hidden mb-4 bg-slate-100 aspect-4/3">
                  <img
                    src="https://images.unsplash.com/photo-1622253692010-333f2da6031d?auto=format&fit=crop&w=700&q=80"
                    alt="Dr. Rajib Das, neurologist, in clinic attire"
                    width="700"
                    height="525"
                    class="w-full h-full object-cover object-top hover:scale-105 transition-transform duration-500"
                    loading="eager"
                    fetchpriority="high"
                  />
                  <div class="absolute bottom-2.5 left-2.5 bg-white/95 backdrop-blur-xs px-2.5 py-1 rounded-lg border border-slate-200 text-xs font-bold text-slate-800 shadow-xs flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
                    Available at Clinic Today
                  </div>
                </div>

                <div class="text-center space-y-0.5 mb-4">
                  <h2 class="text-lg font-black text-slate-900 font-serif">Dr. Rajib Das</h2>
                  <p class="text-xs text-teal-800 font-bold">MBBS, MD (Neurology)</p>
                  <p class="text-xs text-slate-500">Senior Neurologist & Stroke Consultant</p>
                </div>

                <div class="space-y-1.5 bg-slate-50 p-3.5 rounded-xl border border-slate-200 text-xs">
                  <div class="flex items-center justify-between text-slate-600">
                    <span class="font-medium text-slate-500">Board Status:</span>
                    <span class="font-bold text-slate-800">MD in Neurology</span>
                  </div>
                  <div class="flex items-center justify-between text-slate-600">
                    <span class="font-medium text-slate-500">OPD Timings:</span>
                    <span class="font-bold text-teal-800">09:00 AM – 07:00 PM</span>
                  </div>
                  <div class="flex items-center justify-between text-slate-600">
                    <span class="font-medium text-slate-500">Center:</span>
                    <span class="font-bold text-slate-800">Apex Neurosciences Center</span>
                  </div>
                </div>

                <div class="mt-3.5">
                  <a
                    href="/about"
                    class="block w-full py-2 px-3 rounded-xl text-center text-xs font-bold text-teal-800 hover:text-white bg-teal-50 hover:bg-teal-700 transition-colors border border-teal-200"
                  >
                    View Full Medical Bio & Fellowships →
                  </a>
                </div>

              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 2. Full-horizon stats band (icons + counters that render final values without JS) -->
    <section class="bg-teal-800 text-white py-8 shadow-xs" aria-label="Practice statistics">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
          {stats.map((stat) => (
            <div class="p-2">
              <svg class="w-6 h-6 mx-auto text-teal-300 mb-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={stat.icon}/>
              </svg>
              <div class="text-2xl sm:text-4xl font-black tracking-tight text-white flex items-center justify-center font-serif">
                <span class="counter-number" data-target={stat.target}>{stat.display}</span>
                <span aria-hidden="true">{stat.suffix}</span>
              </div>
              <div class="text-xs font-semibold text-teal-100 uppercase tracking-wider mt-1">
                {stat.label}
              </div>
              <p class="text-xs text-teal-200/80 hidden sm:block mt-0.5">{stat.sub}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. Services -->
    <section class="py-16 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-3xl mx-auto mb-12 reveal">
          <span class="text-xs font-bold uppercase tracking-wider text-teal-800 bg-teal-50 px-3 py-1 rounded-full border border-teal-200">
            Clinical Disciplines
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 mt-2 font-serif">Specialized Neurological Services</h2>
          <p class="mt-2 text-slate-600 text-sm leading-relaxed">
            Targeted clinical investigations and medical interventions for acute and chronic conditions of the nervous system.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {services.map((item, i) => (
            <div class="bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-xs medical-card-hover flex flex-col justify-between group reveal" style={`transition-delay: ${i * 60}ms`}>
              <div>
                <div class="h-40 w-full overflow-hidden relative bg-slate-100">
                  <img
                    src={item.image}
                    alt={item.title}
                    width="600"
                    height="450"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-transparent" aria-hidden="true"></div>
                  <div class="absolute bottom-2.5 left-2.5 bg-white/95 backdrop-blur-xs px-2 py-0.5 rounded-lg text-xs font-bold text-teal-800 flex items-center gap-1 shadow-xs">
                    <svg class="w-3.5 h-3.5 text-teal-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}/>
                    </svg>
                    <span>Specialized Care</span>
                  </div>
                </div>

                <div class="p-5">
                  <h3 class="text-base font-bold text-slate-900 group-hover:text-teal-800 transition-colors mb-1.5 font-serif">
                    {item.title}
                  </h3>
                  <p class="text-xs text-slate-600 leading-relaxed">
                    {item.desc}
                  </p>
                </div>
              </div>

              <div class="p-5 pt-0 border-t border-slate-100 flex items-center justify-between">
                <a href={item.href} class="text-xs font-bold text-teal-700 hover:text-teal-900 flex items-center gap-1">
                  <span>Clinical Process</span>
                  <span aria-hidden="true">→</span>
                </a>
                <button
                  data-open-modal="booking"
                  class="px-3 py-1.5 rounded-lg bg-teal-50 hover:bg-teal-100 text-teal-800 text-xs font-bold transition cursor-pointer"
                >
                  Consult
                </button>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-10 text-center">
          <a
            href="/services"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-slate-900 text-white font-bold text-sm hover:bg-slate-800 shadow-xs transition"
          >
            <span>Explore All Diagnostic Procedures & Prep (EEG, EMG/NCV)</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>

      </div>
    </section>

    <!-- 4. Clinical philosophy -->
    <section class="py-16 bg-white border-t border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          
          <div class="lg:col-span-6 space-y-5 reveal">
            <span class="text-xs font-bold uppercase tracking-wider text-teal-800 bg-teal-50 px-3 py-1 rounded-full border border-teal-200">
              Physician Care Philosophy
            </span>
            <h2 class="text-2xl sm:text-3xl font-black text-slate-900 leading-snug font-serif">
              Evidence-Led Science with Patient-Centered Empathy
            </h2>
            <p class="text-slate-600 leading-relaxed text-sm">
              Neurological conditions can be stressful and emotionally overwhelming for patients and family caretakers. Dr. Rajib Das believes in unhurried active listening, meticulous clinical evaluation, and transparent explanations of every scan and treatment plan.
            </p>
            
            <div class="space-y-2.5 pt-1">
              <div class="flex items-start gap-2.5 bg-slate-50 p-3 rounded-xl border border-slate-200">
                <div class="w-5 h-5 rounded-full bg-teal-100 text-teal-800 flex items-center justify-center shrink-0 mt-0.5 font-bold text-xs" aria-hidden="true">✓</div>
                <p class="text-xs text-slate-700 font-semibold">Unrushed 30-45 minute initial consultations allowing exhaustive evaluation.</p>
              </div>
              <div class="flex items-start gap-2.5 bg-slate-50 p-3 rounded-xl border border-slate-200">
                <div class="w-5 h-5 rounded-full bg-teal-100 text-teal-800 flex items-center justify-center shrink-0 mt-0.5 font-bold text-xs" aria-hidden="true">✓</div>
                <p class="text-xs text-slate-700 font-semibold">Precision review of brain & spine MRI, CT, and neuro-imaging scans.</p>
              </div>
              <div class="flex items-start gap-2.5 bg-slate-50 p-3 rounded-xl border border-slate-200">
                <div class="w-5 h-5 rounded-full bg-teal-100 text-teal-800 flex items-center justify-center shrink-0 mt-0.5 font-bold text-xs" aria-hidden="true">✓</div>
                <p class="text-xs text-slate-700 font-semibold">Emergency on-call accessibility for acute neurological flares.</p>
              </div>
            </div>

            <div class="pt-2 flex flex-wrap gap-2.5">
              <a href="/about" class="px-5 py-2.5 rounded-xl bg-teal-700 text-white font-bold text-sm hover:bg-teal-800 shadow-xs transition">
                Read Full Biography & Background
              </a>
              <button
                data-open-modal="booking"
                class="px-5 py-2.5 rounded-xl bg-slate-100 text-slate-800 font-bold text-sm hover:bg-slate-200 transition cursor-pointer"
              >
                Schedule Appointment
              </button>
            </div>
          </div>

          <div class="lg:col-span-6 space-y-5 reveal">
            <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-sm relative aspect-16/9">
              <img
                src="https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?auto=format&fit=crop&w=800&q=80"
                alt="Modern medical clinic consultation interior"
                width="800"
                height="450"
                class="w-full h-full object-cover"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-900/70 via-transparent to-transparent flex items-end p-5" aria-hidden="true">
                <div class="text-white">
                  <p class="text-xs font-semibold text-teal-300">Apex Neurosciences Center</p>
                  <p class="text-sm font-bold font-serif">State-of-the-art Clinical Electrophysiology & Consultation Suites</p>
                </div>
              </div>
            </div>

            <div class="bg-teal-50/70 rounded-2xl p-5 border border-teal-100 space-y-2">
              <h3 class="text-xs font-black text-slate-900 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-teal-700" aria-hidden="true"></span>
                When Should You Consult a Neurologist?
              </h3>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 text-xs text-slate-700 list-none">
                <li class="flex items-center gap-1.5">• Severe, recurring headaches</li>
                <li class="flex items-center gap-1.5">• Numbness or pins &amp; needles</li>
                <li class="flex items-center gap-1.5">• Unexplained fainting / fits</li>
                <li class="flex items-center gap-1.5">• Involuntary tremors or stiffness</li>
                <li class="flex items-center gap-1.5">• Sudden facial or limb weakness</li>
                <li class="flex items-center gap-1.5">• Memory loss or disorientation</li>
              </ul>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 5. Patient reviews (accessible marquee) -->
    <ReviewsSection />

    <!-- 6. Location & Google Map (card header with directions action) -->
    <section class="py-16 bg-white border-t border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          
          <div class="lg:col-span-5 space-y-5 reveal">
            <span class="text-xs font-bold uppercase tracking-wider text-teal-800 bg-teal-50 px-3 py-1 rounded-full border border-teal-200">
              Clinic Location
            </span>
            <h2 class="text-2xl sm:text-3xl font-black text-slate-900 font-serif">Visit Dr. Rajib Das Clinic</h2>
            <p class="text-sm text-slate-600 leading-relaxed">
              Centrally situated in the city medical corridor with modern elevator access, wheelchair accessibility, and reserved patient parking.
            </p>

            <div class="space-y-3.5 bg-slate-50 p-5 rounded-2xl border border-slate-200 text-sm">
              <div class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-teal-700 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
