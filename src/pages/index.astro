---
import { ANALYTICS } from '../constants/analytics';
import Layout from '../layouts/Layout.astro';
import { CLINIC, whatsappLink } from '../constants/clinic';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';

import AppointmentModal from '../components/AppointmentModal.astro';
import WhatsAppIcon from '../components/icons/WhatsAppIcon.astro';

const phone = CLINIC.phone;
const phoneHref = CLINIC.phoneHref;
const whatsapp = whatsappLink();
const base = import.meta.env.BASE_URL;
/** Prefixes an internal route with the deploy base (GitHub Pages sub-path safe). */
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`;

const services = [
  {
    title: "Stroke & Cerebrovascular Care",
    desc: "Rapid response stroke protocols, ischemic and hemorrhagic management, prevention, and neuro-rehabilitation.",
    icon: "M13 10V3L4 14h7v7l9-11h-7z",
    image: "https://images.unsplash.com/photo-1551076805-e1869033e561?auto=format&fit=crop&w=800&q=85",
    href: "/services"
  },
  {
    title: "Chronic Migraine & Headache",
    desc: "Targeted diagnosis of cluster, tension, and persistent migraines with modern prophylactic protocols and relief plans.",
    icon: "M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z",
    image: "https://images.unsplash.com/photo-1579684453423-f84349ef60b0?auto=format&fit=crop&w=800&q=85",
    href: "/services"
  },
  {
    title: "Epilepsy & Seizure Disorders",
    desc: "Digital Video EEG monitoring, seizure classification, and medication management for pediatric and adult patients.",
    icon: "M13 7h8m0 0v8m0-8l-8 8-4-4-6 6",
    image: "https://images.unsplash.com/photo-1631815587646-b85a1bb027e1?auto=format&fit=crop&w=800&q=85",
    href: "/services"
  },
  {
    title: "Parkinson's & Movement Care",
    desc: "Advanced therapeutic interventions for hand tremors, rigid posture, Parkinson's disease, and balance disorders.",
    icon: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
    image: "https://images.unsplash.com/photo-1583324113626-70df0f4deaab?auto=format&fit=crop&w=800&q=85",
    href: "/services"
  },
  {
    title: "Neuropathy & Sciatica Relief",
    desc: "Electromyography (EMG) and Nerve Conduction Velocity (NCV) testing for diabetic nerve pain and spinal radiculopathy.",
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
    image: "https://images.unsplash.com/photo-1581594693702-fbdc51b2763b?auto=format&fit=crop&w=800&q=85",
    href: "/services"
  },
  {
    title: "Memory Loss & Dementia",
    desc: "Detailed cognitive screenings for early Alzheimer's, memory deficits, and supportive care plans for families.",
    icon: "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z",
    image: "https://images.unsplash.com/photo-1666214280557-f1b5022eb634?auto=format&fit=crop&w=800&q=85",
    href: "/services"
  }
];

// Stat values are rendered as final text in HTML (so they're correct without JS);
// the script animates from 0 only when the band scrolls into view.
const stats = [
  { target: 15, suffix: '+', display: '15', label: 'Years Clinical Practice', sub: 'Specialized neuro care', icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z' },
  { target: 12500, suffix: '+', display: '12,500', label: 'Patients Treated', sub: 'Comprehensive consultations', icon: "M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 10-4-4 4 4 0 004 4zm6-4a4 4 0 11-4-4" },
  { target: 25, suffix: '+', display: '25', label: 'Clinical Publications', sub: 'Medical research & journals', icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253' },
  { target: 99, suffix: '%', display: '99', label: 'Patient Satisfaction', sub: 'Based on 248+ reviews', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' },
];
---

<Layout
  plausibleDomain={ANALYTICS.plausibleDomain}
  ga4Id={ANALYTICS.ga4MeasurementId}
  enableConsentBanner={ANALYTICS.enableConsentBanner}
  title="Dr. Kanika, MBBS, MD (Neurology) | Neurologist & Brain Specialist"
  description="Consult with Dr. Kanika, leading Neurologist specializing in Stroke, Migraine, Epilepsy, Parkinson's, Nerve Pain, "
  currentPage="/"
>
  <Navbar currentPage="/" />

  <main id="main-content">
        <!-- 1. Hero - Redesigned for Trust-First Family Clinic -->
    <section class="relative bg-white pt-20 pb-16 lg:pt-32 lg:pb-24 overflow-hidden" aria-label="Welcome">
      <!-- Soft warm gradient background -->
      <div class="absolute inset-0 bg-gradient-to-br from-white via-[#fcfaf8] to-[#f0f6fc] pointer-events-none" aria-hidden="true"></div>
      
      <!-- Faint Medical Cross / Star accent -->
      <div class="absolute top-1/4 right-0 opacity-[0.03] pointer-events-none" aria-hidden="true">
        <svg width="400" height="400" viewBox="0 0 100 100" fill="currentColor" class="text-teal-900">
          <path d="M40 0h20v40h40v20H60v40H40V60H0V40h40V0z"/>
        </svg>
      </div>

      <div class="relative z-10 container-main mx-auto">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
          
          <!-- Left: Content -->
          <div class="max-w-2xl mx-auto lg:mx-0 text-center lg:text-left reveal">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-teal-100 mb-8">
              <span class="flex w-2 h-2 rounded-full bg-teal-500" aria-hidden="true"></span>
              <span class="text-xs font-semibold text-teal-800 uppercase tracking-wider">Trusted Family Neurologist</span>
            </div>
            
            <h1 class="text-4xl sm:text-5xl lg:text-6xl text-slate-900 font-medium leading-[1.1] tracking-tight mb-6" style="font-family: var(--font-serif);">
              Expert Neurological Care,<br/>
              <span class="text-teal-700">For You Only.</span>
            </h1>
            
            <p class="text-lg sm:text-xl text-slate-600 mb-10 leading-relaxed max-w-xl mx-auto lg:mx-0">
              We combine advanced medical expertise with compassionate, personalized care to treat complex neurological conditions for you and your loved ones.
            </p>
            
            <div class="flex flex-col sm:flex-row items-center gap-4 justify-center lg:justify-start">
              <button type="button" data-open-modal="booking" class="nav-cta-btn btn-lg w-full sm:w-auto justify-center">
                Book Consultation
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </button>
              <a href={phoneHref} class="inline-flex w-full sm:w-auto items-center justify-center gap-2 px-8 py-3.5 rounded-full bg-white border-2 border-slate-200 hover:border-teal-600 text-slate-700 hover:text-teal-700 font-semibold transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                {phone}
              </a>
            </div>
            
            <div class="mt-12 grid grid-cols-3 gap-4 border-t border-slate-200 pt-8">
              <div>
                <p class="text-3xl font-bold text-slate-900" style="font-family: var(--font-serif);">15+</p>
                <p class="text-sm text-slate-500 font-medium">Years Exp.</p>
              </div>
              <div>
                <p class="text-3xl font-bold text-slate-900" style="font-family: var(--font-serif);">5k+</p>
                <p class="text-sm text-slate-500 font-medium">Happy Patients</p>
              </div>
              <div>
                <p class="text-3xl font-bold text-slate-900" style="font-family: var(--font-serif);">4.9</p>
                <p class="text-sm text-slate-500 font-medium">Rating (Practo)</p>
              </div>
            </div>
          </div>
          
          <!-- Right: Image -->
          <div class="relative reveal" style="transition-delay: 200ms;">
            <!-- Decorative background shape -->
            <div class="absolute inset-0 bg-teal-600/10 rounded-3xl rotate-3 scale-105 pointer-events-none" aria-hidden="true"></div>
            <div class="relative rounded-3xl overflow-hidden shadow-2xl bg-white">
              <img 
                src="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&q=80&w=1200&h=1400" 
                alt="Doctor Kanika, Neurologist" 
                class="w-full h-auto object-cover aspect-[4/5]"
                width="960"
                height="1200"
                loading="eager"
                fetchpriority="high"
              />
              
              <!-- Floating trust badge (solid surface, no glass) -->
              <div class="absolute bottom-6 left-6 right-6 sm:left-auto sm:right-[-2rem] bg-white rounded-2xl p-4 shadow-xl border border-slate-200 flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-teal-50 flex items-center justify-center shrink-0">
                  <svg class="w-6 h-6 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <div>
                  <p class="text-sm font-bold text-slate-900">Top Rated Care</p>
                  <p class="text-xs text-slate-500">Recognized for excellence</p>
                </div>
              </div>
            </div>
          </div>
          
        </div>
      </div>
    </section>
    <!-- 2. Full-horizon stats band (icons + counters that render final values without JS) -->
    <section class="bg-teal-50 border-y border-teal-100 py-10 md:py-12" aria-label="Practice statistics">
      <div class="container-main">
        <div class="grid grid-cols-2 gap-4 sm:gap-6 md:grid-cols-4 text-center">
          {stats.map((stat) => (
            <div class="p-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={stat.icon}/>
              </svg>
              <div class="text-stat text-charcoal flex items-center justify-center">
                <span class="counter-number" data-target={stat.target}>{stat.display}</span>
                <span aria-hidden="true">{stat.suffix}</span>
              </div>
              <div class="text-label text-teal-700 mt-1">
                {stat.label}
              </div>
              <p class="text-xs text-mist hidden sm:block mt-0.5">{stat.sub}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. Services — Card Grid -->
    <section id="services" class="section bg-white" aria-label="Neurological services">
      <div class="container-main">

        <!-- Section header -->
        <div class="max-w-2xl mb-8 md:mb-12 reveal">
          <div class="inline-flex items-center gap-2 mb-4">
            <span class="text-teal-600 font-bold text-xs">→</span>
            <span class="text-label text-teal-700 tracking-[0.18em]">Our Services</span>
          </div>
          <h2 class="text-h2 text-charcoal font-medium mb-3">Comprehensive Neurological Care</h2>
          <p class="text-body text-graphite max-w-xl">Expert diagnosis and treatment for a wide range of neurological conditions.</p>
        </div>

        <!-- Service Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          {services.map((item, i) => (
            <div class="group bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-[0_4px_20px_-4px_rgba(15,23,42,0.05)] hover:shadow-[0_8px_30px_-4px_rgba(12,74,138,0.12)] hover:border-teal-200 transition-all duration-300 reveal" style={`transition-delay: ${i * 80}ms`}>
              <!-- Card Image -->
              <div class="relative h-48 overflow-hidden">
                <img
                  src={item.image}
                  alt=""
                  role="presentation"
                  width="600"
                  height="400"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </div>
              <!-- Card Content -->
              <div class="p-6">
                <div class="flex items-center gap-3 mb-3">
                  <div class="w-10 h-10 rounded-xl bg-teal-50 flex items-center justify-center text-teal-700 shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={item.icon}/>
                    </svg>
                  </div>
                  <h3 class="text-h5 text-charcoal font-semibold">{item.title}</h3>
                </div>
                <p class="text-body-sm text-graphite mb-4 line-clamp-3">{item.desc}</p>
                <a href={withBase(item.href)} class="inline-flex items-center gap-1.5 text-sm font-semibold text-teal-700 hover:text-teal-900 transition-colors">
                  Learn More <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
))}
        </div>

        <div class="text-center mt-16 reveal">
          <a href={`${import.meta.env.BASE_URL}services`} class="nav-cta-btn whitespace-nowrap">
            View All Services <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>
    <!-- 3b. Doctor Profile + Our Approach — Reference 3 -->
    <section id="about-doctor" class="section bg-cream" aria-label="Meet Dr. Kanika">
      <div class="container-main">

        <!-- Doctor Profile Row -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center mb-16 lg:mb-20">
          <!-- Left: Doctor Photo -->
          <div class="relative max-w-md mx-auto lg:max-w-none reveal">
            <img 
              src="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&q=80&w=800" 
              alt="Dr. Kanika — Neurologist" 
              class="w-full rounded-2xl shadow-md object-cover"
              width="700"
              height="850"
              loading="lazy"
            />
            <!-- Signature overlay -->
            <div class="absolute bottom-4 left-4 bg-white rounded-lg px-4 py-2 shadow-sm border border-slate-200" aria-hidden="true">
              <p class="font-serif italic text-sm text-slate-500">Dr. Kanika</p>
              <p class="text-xs text-mist">Neurologist</p>
            </div>
          </div>

          <!-- Right: Bio & Credentials -->
          <div class="space-y-6 reveal" style="transition-delay: 100ms;">
            <div class="inline-flex items-center gap-2">
              <span class="text-teal-600 font-bold text-xs">→</span>
              <span class="text-label text-teal-700 tracking-[0.18em]">Meet Your Neurologist</span>
            </div>

            <h2 class="text-display text-charcoal font-medium leading-tight">Dr. Kanika</h2>
            <p class="text-lg text-teal-700 font-medium">Consultant Neurologist & Neurophysiologist</p>
            
            <p class="text-body text-graphite max-w-lg">
              With over 15 years of experience in neurology and neurophysiology, Dr. Kanika provides compassionate, evidence-based care for a wide range of neurological conditions. Her patient-first approach ensures personalized treatment and better outcomes.
            </p>

            <!-- Credential Badges -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
              <div class="flex flex-col items-center text-center p-3 rounded-xl border border-slate-200 bg-white">
                <div class="w-8 h-8 rounded-full bg-teal-50 flex items-center justify-center text-teal-700 mb-2">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                </div>
                <p class="text-charcoal font-bold text-sm">15+ Years</p>
                <p class="text-mist text-xs">Clinical Experience</p>
              </div>
              <div class="flex flex-col items-center text-center p-3 rounded-xl border border-slate-200 bg-white">
                <div class="w-8 h-8 rounded-full bg-teal-50 flex items-center justify-center text-teal-700 mb-2">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342"/></svg>
                </div>
                <p class="text-charcoal font-bold text-sm">MBBS</p>
                <p class="text-mist text-xs">General Medicine</p>
              </div>
              <div class="flex flex-col items-center text-center p-3 rounded-xl border border-slate-200 bg-white">
                <div class="w-8 h-8 rounded-full bg-teal-50 flex items-center justify-center text-teal-700 mb-2">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693L5 16.5m14.8-1.2a9 9 0 10-15.6 0"/></svg>
                </div>
                <p class="text-charcoal font-bold text-sm">MD</p>
                <p class="text-mist text-xs">(Neurology)</p>
              </div>
              <div class="flex flex-col items-center text-center p-3 rounded-xl border border-slate-200 bg-white">
                <div class="w-8 h-8 rounded-full bg-teal-50 flex items-center justify-center text-teal-700 mb-2">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                </div>
                <p class="text-charcoal font-bold text-sm">EEG & EMG</p>
                
              </div>
            </div>

            <button type="button" data-open-modal="booking" class="nav-cta-btn mt-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              Schedule Consultation
              <span aria-hidden="true">→</span>
            </button>
          </div>
        </div>

        <!-- Our Approach — Horizontal Steps -->
        <div class="border-t border-slate-200 pt-12 lg:pt-16">
          <div class="flex flex-col lg:flex-row items-start gap-8 lg:gap-12 mb-10 lg:mb-14">
            <div class="lg:w-1/3 reveal">
              <div class="inline-flex items-center gap-2 mb-3">
                <span class="text-teal-600 font-bold text-xs">→</span>
                <span class="text-label text-teal-700 tracking-[0.18em]">Our Approach</span>
              </div>
              <h3 class="text-h2 text-charcoal font-medium leading-snug">A Patient-Centered Approach to Neurological Care</h3>
              <p class="text-body text-graphite mt-3">We listen, understand, and create personalized treatment plans for better outcomes.</p>
            </div>

            <!-- 4 Steps Horizontal -->
            <div class="lg:w-2/3 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
              <!-- Step 1 -->
              <div class="flex flex-row sm:flex-col items-center sm:items-start text-left reveal gap-4 sm:gap-0" style="transition-delay: 50ms;">
                <div class="w-14 h-14 sm:w-12 sm:h-12 shrink-0 rounded-full bg-teal-50 flex items-center justify-center text-teal-700 sm:mb-4 border border-teal-100 shadow-sm">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z"/></svg>
                </div>
                <div>
                  <p class="text-teal-800 font-bold text-sm sm:text-base mb-1 tracking-tight">01. Hear Your Story</p>
                  <p class="text-slate-500 text-xs sm:text-sm leading-relaxed">Actively listening to understand your unique symptoms and history.</p>
                </div>
              </div>
              
              <!-- Step 2 -->
              <div class="flex flex-row sm:flex-col items-center sm:items-start text-left reveal gap-4 sm:gap-0" style="transition-delay: 100ms;">
                <div class="w-14 h-14 sm:w-12 sm:h-12 shrink-0 rounded-full bg-teal-50 flex items-center justify-center text-teal-700 sm:mb-4 border border-teal-100 shadow-sm">
