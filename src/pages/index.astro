---
import { ANALYTICS } from '../constants/analytics';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import AppointmentModal from '../components/AppointmentModal.astro';
import PhoneIcon from '../components/icons/PhoneIcon.astro';
import WhatsAppIcon from '../components/icons/WhatsAppIcon.astro';
import CalendarIcon from '../components/icons/CalendarIcon.astro';

const phone = "+91 98765 43210";
const whatsapp = "https://wa.me/919876543210?text=" + encodeURIComponent("Hello Dr. Rajib Das Clinic, I would like to schedule a neurology consultation.");

const services = [
  {
    title: "Stroke & Cerebrovascular Care",
    desc: "Rapid response stroke protocols, ischemic and hemorrhagic management, prevention, and neuro-rehabilitation.",
    icon: "M13 10V3L4 14h7v7l9-11h-7z",
    image: "https://images.unsplash.com/photo-1559757175-5700dde675bc?auto=format&fit=crop&w=600&q=80",
    href: "/services"
  },
  {
    title: "Chronic Migraine & Headache",
    desc: "Targeted diagnosis of cluster, tension, and persistent migraines with modern prophylactic protocols and relief plans.",
    icon: "M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z",
    image: "https://images.unsplash.com/photo-1505751172876-fa1923c5c528?auto=format&fit=crop&w=600&q=80",
    href: "/services"
  },
  {
    title: "Epilepsy & Seizure Disorders",
    desc: "Digital Video EEG monitoring, seizure classification, and medication management for pediatric and adult patients.",
    icon: "M13 7h8m0 0v8m0-8l-8 8-4-4-6 6",
    image: "https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&w=600&q=80",
    href: "/services"
  },
  {
    title: "Parkinson's & Movement Care",
    desc: "Advanced therapeutic interventions for hand tremors, rigid posture, Parkinson's disease, and balance disorders.",
    icon: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
    image: "https://images.unsplash.com/photo-1584515979956-d9f6e5d09982?auto=format&fit=crop&w=600&q=80",
    href: "/services"
  },
  {
    title: "Neuropathy & Sciatica Relief",
    desc: "Electromyography (EMG) and Nerve Conduction Velocity (NCV) testing for diabetic nerve pain and spinal radiculopathy.",
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
    image: "https://images.unsplash.com/photo-1530497610245-94d3c16cda28?auto=format&fit=crop&w=600&q=80",
    href: "/services"
  },
  {
    title: "Memory Loss & Dementia",
    desc: "Detailed cognitive screenings for early Alzheimer's, memory deficits, and supportive care plans for families.",
    icon: "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z",
    image: "https://images.unsplash.com/photo-1576765608535-5f04d1e3f289?auto=format&fit=crop&w=600&q=80",
    href: "/services"
  }
];

// Stat values are rendered as final text in HTML (so they're correct without JS);
// the script animates from 0 only when the band scrolls into view.
const stats = [
  { target: 15, suffix: '+', display: '15', label: 'Years Clinical Practice', sub: 'Specialized neuro care', icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z' },
  { target: 12500, suffix: '+', display: '12,500', label: 'Patients Treated', sub: 'Comprehensive consultations', icon: "M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 10-4-4 4 4 0 004 4zm6-4a4 4 0 11-4-4" },
  { target: 3800, suffix: '+', display: '3,800', label: 'EEG & EMG Diagnostics', sub: 'High precision neurophysiology', icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
  { target: 99, suffix: '%', display: '99', label: 'Patient Satisfaction', sub: 'Based on 248+ reviews', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' },
];
---

<Layout
  plausibleDomain={ANALYTICS.plausibleDomain}
  ga4Id={ANALYTICS.ga4MeasurementId}
  enableConsentBanner={ANALYTICS.enableConsentBanner}
  title="Dr. Rajib Das, MBBS, MD (Neurology) | Neurologist & Brain Specialist"
  description="Consult with Dr. Rajib Das, leading Neurologist specializing in Stroke, Migraine, Epilepsy, Parkinson's, Nerve Pain, EEG & EMG diagnostics."
  currentPage="/"
>
  <Navbar currentPage="/" />

  <main id="main-content">
    <!-- 1. Hero -->
    <section class="hero-premium relative overflow-hidden" aria-label="Welcome">
      
      <!-- Video Background -->
      <div class="absolute inset-0" aria-hidden="true">
        <video 
          autoplay 
          loop 
          muted 
          playsinline 
          class="w-full h-full object-cover object-center scale-105"
          poster="https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?auto=format&fit=crop&w=1800&q=85"
        >
          <source src="https://www.w3schools.com/html/mov_bbb.mp4" type="video/mp4" />
        </video>
        <!-- Deep premium overlay: dark slate/teal gradient for contrast -->
        <div class="absolute inset-0 bg-gradient-to-r from-slate-900/90 via-slate-900/75 to-teal-900/60"></div>
        <div class="absolute inset-0 bg-slate-900/30"></div>
      </div>

      <div class="relative z-10 container-main flex flex-col lg:flex-row items-center gap-12 lg:gap-8 min-h-[95svh] py-24 lg:py-32">
        
        <!-- Left: Typography & Value Prop -->
        <div class="flex-1 space-y-8 mt-12 lg:mt-0">
          <div class="inline-flex items-center gap-2.5">
            <span class="w-8 h-px bg-teal-400" aria-hidden="true"></span>
            <span class="text-label text-teal-300 tracking-[0.2em]">Senior Consultant Neurologist</span>
          </div>

          <h1 class="text-display text-white max-w-2xl leading-[1.1]">
            Advanced precision.<br>
            <span class="text-teal-200 font-serif italic text-[1.05em]">Human understanding.</span>
          </h1>

          <p class="text-lead text-slate-300 max-w-[48ch]">
            Expert clinical diagnosis and unhurried care for complex neurological conditions, equipped with state-of-the-art EEG and EMG diagnostics.
          </p>

          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5 pt-4">
            <button
              data-open-modal="booking"
              class="btn btn-teal px-8 py-4 text-base shadow-[0_0_20px_rgba(36,80,70,0.4)] hover:shadow-[0_0_30px_rgba(36,80,70,0.6)] transition-shadow duration-300"
            >
              Book Consultation
            </button>
            <a
              href="#services"
              class="group inline-flex items-center gap-2 text-body font-medium text-white hover:text-teal-200 transition-colors"
            >
              <span class="w-10 h-10 rounded-full border border-slate-500/50 flex items-center justify-center group-hover:border-teal-400 transition-colors">
                &darr;
              </span>
              <span>Explore Treatments</span>
            </a>
          </div>
        </div>

        <!-- Right: Floating Glass Profile Card -->
        <div class="w-full max-w-md lg:w-[420px] shrink-0 reveal" style="transition-delay: 200ms;">
          <div class="backdrop-blur-xl bg-white/10 border border-white/20 rounded-3xl p-1 shadow-2xl relative overflow-hidden group">
            <div class="absolute inset-0 bg-gradient-to-br from-white/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"></div>
            <div class="bg-slate-900/80 backdrop-blur-md rounded-[1.375rem] p-8 border border-white/5">
              
              <div class="flex items-center gap-5 mb-8">
                <div class="w-20 h-20 rounded-full overflow-hidden border-2 border-teal-500/30 shrink-0 relative">
                  <img src="https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?auto=format&fit=crop&w=150&q=80" alt="Dr Rajib Das" class="w-full h-full object-cover grayscale opacity-90 group-hover:grayscale-0 transition-all duration-700" />
                </div>
                <div>
                  <h2 class="text-h4 text-white mb-1">Dr. Rajib Das</h2>
                  <p class="text-caption text-teal-300 font-semibold tracking-wider uppercase">MBBS, MD (Neurology)</p>
                </div>
              </div>

              <div class="space-y-4">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center text-teal-400 shrink-0"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg></div>
                  <span class="text-slate-300 text-body-sm">15+ Years Clinical Excellence</span>
                </div>
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center text-teal-400 shrink-0"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg></div>
                  <span class="text-slate-300 text-body-sm">Gold Medalist &amp; Board Certified</span>
                </div>
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center text-teal-400 shrink-0"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg></div>
                  <span class="text-slate-300 text-body-sm">In-house EEG &amp; EMG Lab</span>
                </div>
              </div>

              <div class="mt-8 pt-6 border-t border-white/10 flex justify-between items-center">
                <span class="text-caption text-slate-400">Accepting New Patients</span>
                <div class="flex -space-x-2">
                  <img src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=100&q=80" class="w-8 h-8 rounded-full border-2 border-slate-900" alt="Patient review" />
                  <img src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=100&q=80" class="w-8 h-8 rounded-full border-2 border-slate-900" alt="Patient review" />
                  <div class="w-8 h-8 rounded-full border-2 border-slate-900 bg-teal-800 text-white flex items-center justify-center text-[10px] font-bold">+2k</div>
                </div>
              </div>

            </div>
          </div>
        </div>

      </div>
    </section>
    <!-- 2. Full-horizon stats band (icons + counters that render final values without JS) -->
    <section class="bg-teal-800 text-white py-12" aria-label="Practice statistics">
      <div class="container-main">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
          {stats.map((stat) => (
            <div class="p-2">
              <svg class="w-6 h-6 mx-auto text-teal-300 mb-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={stat.icon}/>
              </svg>
              <div class="text-stat text-white flex items-center justify-center">
                <span class="counter-number" data-target={stat.target}>{stat.display}</span>
                <span aria-hidden="true">{stat.suffix}</span>
              </div>
              <div class="text-label-light text-teal-100 mt-1">
                {stat.label}
              </div>
              <p class="text-xs text-teal-200/80 hidden sm:block mt-0.5">{stat.sub}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. Services -->
    <section id="services" class="section bg-ivory border-b border-beige" aria-label="Neurological services">
      <div class="container-main">

        <!-- Section header -->
        <div class="svc-header reveal">
          <p class="svc-overline">Clinical Disciplines</p>
          <h2 class="svc-title">Specialized Neurological Services</h2>
          <p class="svc-subtitle">Targeted clinical investigations and medical interventions for acute and chronic conditions of the nervous system.</p>
        </div>

        <!-- Editorial service list -->
        <ol class="svc-list" aria-label="Services list">
          {services.map((item, i) => {
            const num = String(i + 1).padStart(2, '0');
            return (
              <li class="svc-row group reveal" style={`transition-delay: ${i * 50}ms`}>
                <a href={item.href} class="svc-row-link">
                  <span class="svc-num" aria-hidden="true">{num}</span>
                  <div class="svc-row-body">
                    <h3 class="svc-row-title">{item.title}</h3>
                    <p class="svc-row-desc">{item.desc}</p>
                  </div>
                  <span class="svc-arrow" aria-hidden="true">→</span>
                  <div class="svc-row-img-wrap" aria-hidden="true">
                    <img
                      src={item.image}
                      alt=""
                      role="presentation"
                      width="600"
                      height="400"
                      loading="lazy"
                      decoding="async"
                      class="svc-row-img"
                    />
                  </div>
                </a>
              </li>
            );
          })}
        </ol>

        <!-- Footer CTA -->
        <div class="svc-footer reveal">
          <a href={`${import.meta.env.BASE_URL}services`} class="svc-footer-link">
            <span>Explore All Diagnostic Procedures & Prep</span>
            <span class="svc-footer-arrow" aria-hidden="true">→</span>
          </a>
        </div>

      </div>
    </section>
    <!-- 3b. Patient Journey -->
    <section id="journey" class="journey-section section bg-ivory border-t border-beige" aria-label="Patient journey">
      <div class="container-main">

        <!-- Section header -->
        <div class="journey-header reveal">
          <p class="journey-overline">The Journey</p>
          <h2 class="journey-title">From your first concern<br>to a clearer tomorrow.</h2>
        </div>

        <!-- Stage list -->
        <ol class="journey-list" aria-label="Stages of care">

          <!-- 01 Listen -->
          <li class="journey-stage reveal">
            <div class="journey-stage-left">
              <span class="journey-num" aria-hidden="true">01</span>
              <div class="journey-connector" aria-hidden="true"></div>
            </div>
            <div class="journey-stage-body">
              <span class="journey-stage-label">Listen</span>
              <h3 class="journey-stage-heading">Every symptom deserves unhurried attention.</h3>
              <p class="journey-stage-copy">Your first consultation with Dr. Das lasts 30 to 45 minutes — long enough to hear the full story behind your headaches, your tremors, your fear. Nothing is dismissed.</p>
            </div>
            <div class="journey-stage-image" aria-hidden="true">
              <img
                src="https://images.unsplash.com/photo-1582750433449-648ed127bb54?auto=format&fit=crop&w=600&q=75"
                alt=""
                role="presentation"
                width="600"
                height="400"
                loading="lazy"
                decoding="async"
                class="journey-img"
              />
            </div>
          </li>

          <!-- 02 Understand -->
          <li class="journey-stage reveal">
            <div class="journey-stage-left">
              <span class="journey-num" aria-hidden="true">02</span>
              <div class="journey-connector" aria-hidden="true"></div>
            </div>
            <div class="journey-stage-body">
              <span class="journey-stage-label">Understand</span>
              <h3 class="journey-stage-heading">Science meets clarity.</h3>
              <p class="journey-stage-copy">On-site EEG, EMG, and NCV testing, plus precision review of your MRI and CT scans, transforms uncertainty into an evidence-based picture you can finally see and understand.</p>
            </div>
            <div class="journey-stage-image" aria-hidden="true">
              <img
                src="https://images.unsplash.com/photo-1559757175-5700dde675bc?auto=format&fit=crop&w=600&q=75"
                alt=""
                role="presentation"
                width="600"
                height="400"
                loading="lazy"
                decoding="async"
                class="journey-img"
              />
            </div>
          </li>

          <!-- 03 Treat -->
          <li class="journey-stage reveal">
            <div class="journey-stage-left">
              <span class="journey-num" aria-hidden="true">03</span>
              <div class="journey-connector" aria-hidden="true"></div>
            </div>
            <div class="journey-stage-body">
              <span class="journey-stage-label">Treat</span>
              <h3 class="journey-stage-heading">A plan built around you — not a protocol.</h3>
              <p class="journey-stage-copy">Whether stroke, Parkinson's, epilepsy, or nerve pain, every treatment plan is designed for your specific physiology, life, and goals. Modern therapeutics. Transparent reasoning.</p>
            </div>
            <div class="journey-stage-image" aria-hidden="true">
              <img
                src="https://images.unsplash.com/photo-1584515979956-d9f6e5d09982?auto=format&fit=crop&w=600&q=75"
                alt=""
                role="presentation"
                width="600"
                height="400"
                loading="lazy"
                decoding="async"
                class="journey-img"
              />
            </div>
          </li>

          <!-- 04 Follow Through -->
          <li class="journey-stage journey-stage--last reveal">
            <div class="journey-stage-left">
              <span class="journey-num" aria-hidden="true">04</span>
              <!-- no connector on last -->
            </div>
            <div class="journey-stage-body">
              <span class="journey-stage-label">Follow Through</span>
              <h3 class="journey-stage-heading">The relationship continues after the clinic.</h3>
              <p class="journey-stage-copy">Emergency on-call access, structured review appointments, and ongoing management mean the care doesn't end when you walk out the door.</p>
            </div>
            <div class="journey-stage-image" aria-hidden="true">
              <img
                src="https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?auto=format&fit=crop&w=600&q=75"
                alt=""
                role="presentation"
                width="600"
                height="400"
                loading="lazy"
                decoding="async"
                class="journey-img"
              />
            </div>
          </li>

        </ol>

        <!-- Closing pull-quote -->
        <div class="journey-cta reveal">
          <p class="journey-quote">"Precision is a science. Compassion is a choice."</p>
          <button data-open-modal="booking" class="btn btn-teal px-8 py-3.5 text-base">
            Begin Your Journey
          </button>
        </div>

      </div>
    </section>

    <!-- 3c. Cinematic Statement -->
    <section class="cine-statement" aria-label="Precision and understanding">
      <div class="cine-statement-media" aria-hidden="true">
        <img
          src="https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?auto=format&fit=crop&w=1600&q=80"
          alt=""
          role="presentation"
          width="1600"
          height="900"
          class="cine-statement-img"
          loading="lazy"
          decoding="async"
        />
        <div class="cine-statement-scrim"></div>
      </div>
      <div class="cine-statement-content reveal">
        <p class="cine-statement-line-1">Precision matters.</p>
        <p class="cine-statement-line-2">But so does understanding.</p>
      </div>
    </section>
    <!-- 4. Care Philosophy -->
    <section class="philosophy-section section" aria-label="Care philosophy">
      <div class="container-main">

        <!-- Header -->
        <div class="philosophy-header reveal">
          <p class="philosophy-overline">Our Approach</p>
          <h2 class="philosophy-title">Evidence <span class="philosophy-plus">+</span> Empathy</h2>
          <p class="philosophy-intro">
            Neurological conditions can be stressful and emotionally overwhelming. Dr. Rajib Das believes in unhurried active listening, meticulous clinical evaluation, and transparent explanations of every scan and treatment plan.
          </p>
        </div>

        <!-- Three principles -->
        <ol class="philosophy-principles" aria-label="Core principles">

          <li class="philosophy-principle reveal">
            <div class="philosophy-principle-num" aria-hidden="true">
              <span class="philosophy-num-text">01</span>
              <span class="philosophy-num-line"></span>
            </div>
            <div class="philosophy-principle-body">
              <h3 class="philosophy-principle-name">Listen</h3>
              <p class="philosophy-principle-copy">Careful attention to the patient's story. Unrushed 30–45 minute initial consultations allowing exhaustive evaluation — because every symptom carries meaning.</p>
            </div>
          </li>

          <li class="philosophy-principle reveal">
            <div class="philosophy-principle-num" aria-hidden="true">
              <span class="philosophy-num-text">02</span>
              <span class="philosophy-num-line"></span>
            </div>
            <div class="philosophy-principle-body">
              <h3 class="philosophy-principle-name">Understand</h3>
              <p class="philosophy-principle-copy">Clear explanations and accurate diagnosis. Precision review of brain and spine MRI, CT, and neuro-imaging scans — so uncertainty becomes a picture you can finally see.</p>
            </div>
          </li>

          <li class="philosophy-principle reveal">
            <div class="philosophy-principle-num" aria-hidden="true">
              <span class="philosophy-num-text">03</span>
            </div>
            <div class="philosophy-principle-body">
              <h3 class="philosophy-principle-name">Plan</h3>
              <p class="philosophy-principle-copy">Personalized treatment and follow-up. Emergency on-call accessibility for acute neurological flares, structured review appointments, and transparent reasoning at every step.</p>
            </div>
          </li>

        </ol>

        <!-- When to consult — preserved as editorial aside -->
        <aside class="philosophy-aside reveal" aria-label="When to consult a neurologist">
          <div class="philosophy-aside-inner">
            <h3 class="philosophy-aside-title">When Should You Consult a Neurologist?</h3>
            <ul class="philosophy-aside-list">
              <li>Severe, recurring headaches</li>
              <li>Numbness or pins &amp; needles</li>
              <li>Unexplained fainting or fits</li>
              <li>Involuntary tremors or stiffness</li>
              <li>Sudden facial or limb weakness</li>
              <li>Memory loss or disorientation</li>
            </ul>
          </div>
          <div class="philosophy-aside-cta">
            <button data-open-modal="booking" class="btn btn-teal px-8 py-3.5">
